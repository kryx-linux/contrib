# Description: light windowmanager based on the original blackbox
# URL:         http://fluxbox.org
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  x11

name=fluxbox
version=1.0rc2
release=1
source="
    http://heanet.dl.sourceforge.net/sourceforge/fluxbox/fluxbox-$version.tar.gz
    fluxbox-generate_menu
    startfluxbox
    http://www.xs4all.nl/~hanb/software/fbsetbg/fbsetbg-20060330.tar.gz
"

build()
{
    cd $SRC/fluxbox-$version
    ./configure \
        --prefix=/usr \
        --disable-nls \
        --enable-xinerama
    make
    make install DESTDIR=$PKG
    cd $SRC/fbsetbg-*
    ./configure
    make
    make install prefix=$PKG/usr mandir=$PKG/usr/man
    install $SRC/fluxbox-generate_menu $PKG/usr/bin/fluxbox-generate_menu
    install $SRC/startfluxbox          $PKG/usr/bin/startfluxbox
}
