# Description: Multi-platform multi-network peer-to-peer client.
# URL: http://mldonkey.sourceforge.net/
# Maintainer: Jose V Beneyto, sepen at crux dot nu
# Packager: Jose V Beneyto, sepen at crux dot nu
# Depends on: ocaml bzip2
# Nice to have: libgd

name=mldonkey
version=3.0.5
release=1
source=(http://download.sourceforge.net/$name/$name-$version.tar.bz2 \
        mlnetd)

build() {
  local OCAML_VER=$(ocaml -version | awk '{print $6}')
  cd $name-$version
  ./configure --prefix=/usr \
              --disable-gui \
              --disable-bittorrent \
              --enable-ocamlver="$OCAML_VER" \
              --disable-debug
  make
  make DESTDIR=$PKG install
  install -d $PKG/var/mlnet
  install -D -m 0755 $SRC/mlnetd $PKG/etc/rc.d/mlnetd
}
