# Description: HTTP/2 framing layer for Python
# URL: https://hyper.rtfd.org/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-build python3-installer python3-wheel

name=python3-hyperframe
version=6.1.0
release=1
source=(https://github.com/python-hyper/hyperframe/archive/v$version/$name-$version.tar.gz)

build() {
  cd hyperframe-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
