# Description: BitTorrent client daemon
# URL:         http://www.murmeldjur.se/btpd/
# Maintainer:  Jürgen Daubert, juergen dot daubert at t-online dot de
# Depends on:  openssl

name=btpd
version=0.13
release=2
source=(http://www.murmeldjur.se/btpd/$name-$version.tar.gz
        $name-$version.patch $name.1)

build() {
    cd $name-$version
    patch -p0 -i $SRC/$name-$version.patch
    ./configure --prefix=/usr
    make
    make DESTDIR=$PKG install
    install -D $SRC/btpd.1 $PKG/usr/man/man1/btpd.1
}
