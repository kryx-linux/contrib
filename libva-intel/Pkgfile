# Description: libva video acceleration for newer intel based setups
# URL:         http://freedesktop.org/wiki/Software/vaapi
# Maintainer:  Thomas Penteker, tek at serverop dot de
# Depends on:  glu ffmpeg libva

name=libva-intel
version=1.8.1
release=1
source=(https://github.com/01org/intel-vaapi-driver/releases/download/${version}/intel-vaapi-driver-${version}.tar.bz2)

build() {
  cd intel-vaapi-driver-$version

  ./configure --prefix=/usr

  sed -i '1265,1266d' src/Makefile

  make
  make DESTDIR=$PKG install
}
