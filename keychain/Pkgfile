name=keychain
version=2.7.1
release=1
source=(http://www.funtoo.org/archive/$name/$name-$version.tar.bz2)

build() {
	cd $name-$version
	install -D -m755 keychain $PKG/usr/bin/keychain
	install -D -m644 keychain.1 $PKG/usr/man/man1/keychain.1
}
