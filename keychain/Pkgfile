# Description: A front-end to ssh-agent.
# URL: https://www.funtoo.org/Keychain
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on:

name=keychain
version=3.0.5
release=1
source=(https://github.com/funtoo/keychain/archive/$version/$name-$version.tar.gz)

build() {
  cd $name-$version

  make keychain.pyz
  install -D -m755 keychain.pyz $PKG/usr/bin/keychain
  mkdir -p $PKG/usr/share/man/man1
  /usr/bin/python3 scripts/build_doc_texts.py --output $PKG/usr/share/man/man1/keychain.1
  #install -D -m644 keychain.1 $PKG/usr/share/man/man1/keychain.1
}
