# Description: Represents the core of the Zope hookable Architecture
# URL: https://github.com/zopefoundation/zope.hookable
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-wheel

name=python3-zope-hookable
version=8.1
release=1
source=(https://pypi.org/packages/source/z/zope_hookable/zope_hookable-$version.tar.gz)

build() {
  cd zope_hookable-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
