# Description: simple process viewer in rust
# URL: https://github.com/epilys/bb
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: rust

name=bb-top
version=0.4.3
release=2
_commit=6c36391b85b93aec5d14864f6822d00dd79f9ba6
source=(https://github.com/TimB87/bb/archive/$_commit/bb-$_commit.tar.gz)

build() {
  prt-get isinst sccache && export RUSTC_WRAPPER=/usr/bin/sccache
  [[ ! -e $PKGMK_SOURCE_DIR/rust ]] && mkdir $PKGMK_SOURCE_DIR/rust

  cargo build --release --manifest-path bb-$_commit/Cargo.toml

  install -Dt $PKG/usr/bin bb-$_commit/target/release/bb
}
