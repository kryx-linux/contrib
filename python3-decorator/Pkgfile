# Description: Python Decorator module
# URL: https://pypi.python.org/pypi/decorator
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-wheel

name=python3-decorator
version=5.3.0
release=1
source=(https://pypi.org/packages/source/d/decorator/decorator-$version.tar.gz)

build() {
  cd decorator-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
