# Description: MessagePack for Python
# URL: https://pypi.org/project/msgpack
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-cython

name=python3-msgpack
version=1.0.7
release=1
source=(https://pypi.io/packages/source/m/msgpack/msgpack-$version.tar.gz)

build() {
  cd msgpack-$version
  /usr/bin/python3 setup.py build
  /usr/bin/python3 setup.py install --root=$PKG --prefix=/usr --optimize=1 --skip-build
}
