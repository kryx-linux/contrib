# Description: patool is a portable command line archive file manager
# URL: https://github.com/wummel/patool
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-setuptools

name=patool
version=2.4.0
release=1
source=(https://github.com/wummel/patool/archive/dist/patool-$version-py2.py3-none-any.whl/$name-$version.tar.gz)

build() {
  cd patool-dist-patool-$version-py2.py3-none-any.whl

  /usr/bin/python3 setup.py build
  /usr/bin/python3 setup.py install --root=$PKG \
    --prefix=/usr \
    --optimize=1 \
    --skip-build
}
