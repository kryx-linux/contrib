# Description: A portable framework for low-level network packet construction
# URL: https://github.com/libnet/libnet
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: iproute2

name=libnet
version=1.3
release=1
source=(https://github.com/libnet/libnet/releases/download/v$version/libnet-$version.tar.gz)

build() {
  cd $name-$version

  ./configure \
    --prefix=/usr \
    --disable-tests

  make
  make DESTDIR=$PKG install

  rm -r $PKG/usr/share/doc/*
  rmdir $PKG/usr/share/doc $PKG/usr/share
}
