name=p5-lwp
version=5.805
release=1
source=(http://search.cpan.org/CPAN/authors/id/G/GA/GAAS/libwww-perl-$version.tar.gz)

build() {
	cd libwww-perl-$version
	perl Makefile.PL -n
	make
	make DESTDIR=$PKG install
	find $PKG -name "perllocal.pod" -exec rm {} \;
	chown -R root:root $PKG
}
