# Description: Sound Open Firmware
# URL: https://www.sofproject.org/
# Maintainer: Tim Biermann, tbier at posteo dot de

name=sof-bin
version=2024.09.2
release=1
source=(https://github.com/thesofproject/sof-bin/releases/download/v$version/$name-$version.tar.gz)

build() {
  cd $name-$version

  install -d $PKG/lib/firmware/intel $PKG/usr/bin
  cp -ar sof* $PKG/lib/firmware/intel/
  install -m 755 tools/* ${PKG}/usr/bin/
}
