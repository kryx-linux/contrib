# Description: Regular Expression wizard
# URL:         http://txt2regex.sf.net
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  bash

name=txt2regex
version=0.8
release=1
source="http://txt2regex.sf.net/$name-$version.tgz"

build() {
    cd $name-$version
    sed -e "/^VERSION=/s/=.*/=$version/" txt2regex-$version.sh > txt2regex
    install -D -m 755 $name     $PKG/usr/bin/$name
    install -D -m 444 $name.man $PKG/usr/man/man1/$name.1
}
