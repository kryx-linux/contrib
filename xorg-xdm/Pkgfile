# Description: xorg display manager
# URL:         http://xorg.freedesktop.org
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Depends on:  xorg-server xorg-xrdb

name=xorg-xdm
version=1.1.1
release=2
source="
    http://xorg.freedesktop.org/releases/individual/app/xdm-$version.tar.gz
    xdm
    crux_linux.xpm.gz
"

build()
{
    cd xdm-$version
    ./configure \
	--prefix=/usr \
        --with-xdmconfigdir=/etc/X11/xdm \
        --with-xdmscriptdir=/etc/X11/xdm
    make
    make install DESTDIR=$PKG
    gunzip            $SRC/crux_linux.xpm.gz
    install -D -m 644 $SRC/crux_linux.xpm $PKG/usr/lib/X11/xdm/pixmaps/crux_linux.xpm
    install -D -m 755 $SRC/xdm            $PKG/etc/rc.d/xdm
    sed -i '/xconsole/d'                  $PKG/etc/X11/xdm/Xsetup_0
    sed -i 's|xorg.xpm|crux_linux.xpm|'   $PKG/etc/X11/xdm/Xresources
    sed -i 's|^:0.*|& vt7|'               $PKG/etc/X11/xdm/Xservers
}
