#ulimit -u ${MAXCHILD}

SVDIR=/service

case "$1" in
    start)
        exec /usr/bin/svscanboot
	;;

    stop)
        /usr/bin/killall svscan
        /usr/bin/killall readproctitle
        /usr/bin/svc -dx $SVDIR/* $SVDIR/*/log
	;;

    *)
  	echo "Usage: $0 start | stop"
	;;
esac
