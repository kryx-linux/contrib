# Description: Python bindings for GPGME
# URL: https://dev.gnupg.org/source/gpgmepy/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on:  gpgme

name=gpgmepy
version=2.0.0
release=1
commit=1c2c1c0b41af5e34e4f6897639fa41ef3932ec7d
source=(https://git.gnupg.org/cgi-bin/gitweb.cgi?p=gpgmepy.git\;a=snapshot\;h=${commit}\;sf=tgz)
renames=($name-$version.tar.gz)

build() {
  cd gpgmepy-*

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
