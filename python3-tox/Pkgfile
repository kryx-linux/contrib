# Description: Python virtualenv management and testing tool
# URL: https://github.com/tox-dev/tox
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-cachetools python3-chardet python3-colorama python3-docutils python3-py python3-pyproject-api python3-toml python3-tomli-w python3-typing_extensions python3-virtualenv

name=python3-tox
version=4.64.3
release=1
source=(https://pypi.io/packages/source/t/tox/tox-$version.tar.gz)

build() {
  cd tox-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
