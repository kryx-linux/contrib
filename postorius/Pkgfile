# Description: The New Mailman Web UI
# URL: https://gitlab.com/mailman/postorius
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Depends on: mailman python3-django-mailman3 python3-readme-renderer

name=postorius
version=1.3.13
release=2
source=(https://gitlab.com/mailman/postorius/-/archive/v$version/postorius-v$version.tar.bz2
  8d00a3c317729f37435bdbd27170f630e341f29e.patch
  postorius-1.3.10-settings.patch)

build() {
  cd $name-v$version

  sed '/example_project/d' -i pyproject.toml

  patch -Np1 -i $SRC/8d00a3c317729f37435bdbd27170f630e341f29e.patch
  patch -Np1 -i $SRC/postorius-1.3.10-settings.patch

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
