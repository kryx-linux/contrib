# Depends on:  

# Better check homepage for what is possible.

name=plugger
version=5.1.3
release=1
source="http://fredrik.hubbe.net/$name/$name-$version.tar.gz"

build() {
    cd $name-$version
    ./configure --prefix=/usr
    make
    install -d           $PKG/{etc,usr/{bin,man/man7,lib/$name}}
    install \
        plugger-$version \
        plugger-controller \
        plugger-oohelper $PKG/usr/bin
    install pluggerrc    $PKG/etc/pluggerrc-$version
    install plugger.7    $PKG/usr/man/man7
    install plugger.so   $PKG/usr/lib/$name
}
