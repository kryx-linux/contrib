#!/bin/sh
#
# /etc/rc.d/gitea: start/stop gitea daemon
#

SSD=/sbin/start-stop-daemon
PROG=/usr/bin/gitea
OPTS="web"
USER="gitea"
GROUP="www"
PID=/run/gitea/gitea.pid

case $1 in
  start)
    if [ ! -e /run/gitea ]; then
      install -d -o $USER -g $GROUP -m 755 /run/gitea
    fi

    $SSD --start -b --pidfile $PID --make-pidfile -c $USER -u $USER --exec $PROG -- $OPTS
    ;;
  stop)
    $SSD --stop -u $USER --retry 10 --pidfile $PID
    ;;
  restart)
    $0 stop
    $0 start
    ;;
  status)
    $SSD --status --pidfile $PID
    case $? in
    0) echo "$PROG is running with pid $(pidof $PROG)" ;;
    1) echo "$PROG is not running but the pid file $PID exists" ;;
    3) echo "$PROG is not running" ;;
    4) echo "Unable to determine the program status" ;;
    esac
    ;;
  *)
    echo "usage: $0 [start|stop|restart|status]"
    ;;
esac

# End of file
