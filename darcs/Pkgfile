# Description: Distributed version control system  
# URL:         http://www.darcs.net/
# Maintainer:  Juergen Daubert, juergen dot daubert at t-online dot de
# Depends on:  curl ncurses openssl zlib libgmp

name=darcs
version=2.1.2
release=1
source=(http://jue.li/crux/files/$name-$version-$release-linux-i386.tar.bz2) 

build() {
    cd $name-$version
    install -D -m 755 darcs $PKG/usr/bin/darcs
    install -D -m 644 darcs.1 $PKG/usr/man/man1/darcs.1
}
