# Description: A library which provides functions for reading DVD video disks.
# URL: http://www.videolan.org/developers/libdvdcss.html
# Maintainer: John McQuah, jmcquah at disroot dot org

name=libdvdcss
version=1.5.0
release=1
source=(https://download.videolan.org/pub/videolan/$name/$version/$name-$version.tar.xz)

build() {
    meson setup $name-$version build --prefix=/usr

    meson compile -C build -j ${JOBS-1}
    DESTDIR="$PKG" meson install -C build

    rm -rf "$PKG"/usr/share
}
