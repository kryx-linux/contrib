# Description: gtk-version of xmessage
# URL:         http://homepages.ihug.co.nz/~trmusson/programs.html#gxmessage
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  gtk

name=gxmessage
version=2.6.2
release=1
source="http://homepages.ihug.co.nz/~trmusson/stuff/$name-$version.tar.gz"

build() {
    cd $name-$version
    ./configure \
        --prefix=/usr \
        --disable-nls
    make
    make install DESTDIR=$PKG
    rm -rf $PKG/usr/share/locale/
}
