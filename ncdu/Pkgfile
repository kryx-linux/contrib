# Maintainer:  Bartlomiej Palmowski, maks1k at wp dot pl

name=ncdu
version=1.4
release=1
source=(http://dev.yorhel.nl/download/$name-$version.tar.gz)

build() {
  cd $name-$version
  ./configure --prefix=/usr --mandir=/usr/man
  make
  make DESTDIR=$PKG install
}
