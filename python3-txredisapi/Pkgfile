# Description: Non-blocking redis client for python
# URL: https://pypi.python.org/pypi/txredisapi/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-twisted

name=python3-txredisapi
version=1.6.0
release=1
source=(https://pypi.org/packages/source/t/txredisapi/txredisapi-$version.tar.gz)

build() {
  cd txredisapi-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
