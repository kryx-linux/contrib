# Description: Zope Configuration Markup Language (ZCML)
# URL: https://github.com/zopefoundation/zope.configuration
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Depends on: python3-zope-i18nmessageid python3-zope-schema

name=python3-zope-configuration
version=7.1
release=1
source=(https://pypi.org/packages/source/z/zope_configuration/zope_configuration-$version.tar.gz)

build() {
  cd zope_configuration-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
