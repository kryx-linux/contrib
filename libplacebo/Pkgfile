# Description: Reusable library for GPU-accelerated video/image rendering primitives
# URL: https://github.com/haasn/libplacebo
# Maintainer: John McQuah, jmcquah at disroot dot org
# Depends on: glad lcms2 shaderc vulkan-loader
# Optional: libunwind

name=libplacebo
version=6.338.1
_commit=716811a3c3d8f7cb4da5cfff083429860b24d2d6
release=1
source=(https://github.com/haasn/$name/archive/$_commit/$name-v$version.tar.gz)

build() {
    meson setup build $name-$_commit \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode nodownload \
        -D b_lto=true \
        -D b_pie=true \
        -D vulkan=enabled \
        -D vulkan-registry=/usr/share/vulkan/registry/vk.xml \
        -D shaderc=enabled \
        -D lcms=enabled \
        -D d3d11=disabled \
        -D demos=false \
        -D tests=false

    meson compile -C build -j ${JOBS:-1}
    DESTDIR=$PKG meson install -C build
}
