# Description: A fast image manipulation library
# URL: http://enlightenment.org/Libraries/Imlib2/
# Maintainer: Matt Housh, jaeger at morpheus dot net
# Depends on: freetype, libid3tag, libpng, libtiff, libungif, xorg-libsm, xorg-libxext

name=imlib2
version=1.4.0
release=1
source=(http://dl.sourceforge.net/sourceforge/enlightenment/$name-$version.tar.gz)

build() {
	cd $name-$version
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
