# Description: Clock scaling userspace tools
# URL: http://www.kernel.org/pub/linux/utils/kernel/cpufreq/cpufreq.html
# Packager:	Alan Mizrahi, alan at mizrahi dot com dot ve
# Maintainer:	Alan Mizrahi, alan at mizrahi dot com dot ve
# Depends on: sysfsutils

name=cpufrequtils
version=0.4
release=1
source=(http://www.kernel.org/pub/linux/utils/kernel/cpufreq/$name-$version.tar.bz2)

build() {
        cd $name-$version
        ./configure --prefix=/usr --disable-nls
        make
        make DESTDIR=$PKG install
}
