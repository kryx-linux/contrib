# Description: C++ interface for the popular glib library.
# URL: https://www.gtkmm.org/
# Maintainer: John McQuah, jmcquah at disroot dot org
# Depends on: glib libsigc++2

name=glibmm-gtk3
version=2.66.8
release=1
source=(https://ftp.gnome.org/pub/GNOME/sources/${name%-gtk3}/${version%.*}/${name%-gtk3}-$version.tar.xz)

build() {
    meson setup build ${name%-gtk3}-$version \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode nodownload \
        -D b_lto=true \
        -D b_pie=true

    meson compile -C build -j ${JOBS-1}
    DESTDIR="$PKG" meson install -C build

    find "$PKG" \( -type f -a -perm -g+w \) -exec chmod g-w '{}' +
}
