name=mg
version=20061119
release=1
source="http://www.xs4all.nl/~hanb/software/mg/mg-$version.tar.gz"

build()
{
    cd $name-$version
    ./configure
    make all install \
        prefix=/usr \
        mandir=/usr/man \
        DESTDIR=$PKG
}
