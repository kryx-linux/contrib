# Description: Lua grammar for tree-sitter
# URL: https://github.com/tree-sitter-grammars/tree-sitter-lua
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: npm tree-sitter-cli

name=tree-sitter-lua
version=0.4.0
release=1
source=(https://github.com/tree-sitter-grammars/tree-sitter-lua/archive/v$version/$name-$version.tar.gz)

build() {
  cd $name-$version

  tree-sitter generate --log

  cd src
  export CFLAGS+=' -fPIC'
  cc $CFLAGS -std=c99 -c parser.c
  cc $CFLAGS -c scanner.c
  cc $LDFLAGS -shared parser.o scanner.o -o parser.so

  install -Dm 644 parser.so $PKG/usr/lib/libtree-sitter-lua.so
  install -d $PKG/usr/share/nvim/runtime/parser/
  ln -s /usr/lib/libtree-sitter-lua.so $PKG/usr/share/nvim/runtime/parser/lua.so
}
