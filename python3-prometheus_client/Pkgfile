# Description: Prometheus instrumentation library for Python applications
# URL: https://github.com/prometheus/client_python
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-wheel

name=python3-prometheus_client
version=0.22.0
release=1
source=(https://pypi.org/packages/source/p/prometheus_client/prometheus_client-$version.tar.gz)

build() {
  cd prometheus_client-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
