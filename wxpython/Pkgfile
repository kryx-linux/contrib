# Description: Python language bindings for the wxWindows toolkit.
# URL: http://www.wxpython.org/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: sten, nick dot steeves at shaw dot ca
# Depends on: pyopengl wxgtk

name=wxpython
version=2.8.9.2
release=1
source=(http://download.sourceforge.net/$name/wxPython-src-$version.tar.bz2)

build() {
	cd wxPython-src-$version/wxPython
	install -d $PKG/usr

	export \
		CFLAGS="$CFLAGS -fno-strict-aliasing" \
		CXXFLAGS="$CXXFLAGS -fno-strict-aliasing"

	python setup.py \
		WXPORT=gtk2 \
		UNICODE=1 \
		BUILD_GLCANVAS=1 \
		install --root=$PKG

	find $PKG -type f \
	\( \
		-name 'AUTHORS' \
		-o -name 'COPYING' \
		-o -name 'INSTALL' \
		-o -name 'NEWS' \
		-o -name 'THANKS' \
		-o -name 'TODO' \
		-o -name 'TODO.txt' \
		-o -name 'README' \
		-o -name 'README.txt' \
	\) -delete
}
