# Description: A system to store and display time-series data.
# URL: http://oss.oetiker.ch/rrdtool/index.en.html
# Maintainer: Danny Rawlins, crux at romster dot me
# Packager: Younes Hafri, ycrux at club-internet dot fr
# Depends on: intltool libart_lgpl libcgi libgd pango tcl

name=rrdtool
version=1.4.8
release=1
source=(http://oss.oetiker.ch/rrdtool/pub/$name-$version.tar.gz
	rrdtool-pangofont.patch)

build() {
	cd $name-$version

	patch -p1 -i $SRC/rrdtool-pangofont.patch

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--enable-shared \
		--enable-perl-site-install \
		--enable-ruby-site-install \
		--disable-libwrap

	make LIBS+="-lglib-2.0"
	make DESTDIR=$PKG install

	rm -r \
		$PKG/usr/share/doc \
		$PKG/usr/share/rrdtool/examples

	# Remove perl crap
	find $PKG \( \
		-name '.packlist' -o \
		-name '*.bs' -o \
		-name 'perllocal.pod' \) -delete

	# Remove empty directories
	find $PKG -depth -empty -delete
}

