# Description: A python package that provides useful locks
# URL: https://github.com/harlowja/fasteners
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-pyproject2setuppy
# Optional: python3-six

name=python3-fasteners
version=0.17.3
release=1
source=(https://pypi.org/packages/source/f/fasteners/fasteners-$version.tar.gz)

build() {
  cd fasteners-$version
  /usr/bin/python3 -m pyproject2setuppy.main build
  /usr/bin/python3 -m pyproject2setuppy.main install --prefix=/usr \
    --root=$PKG \
    --skip-build
}
