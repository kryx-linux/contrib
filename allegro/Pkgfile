# Description: A multi-platform game programming library for C/C++.
# URL: http://alleg.sourceforge.net/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: sten, nick dot steeves at shaw dot ca
# Depends on: alsa-lib cmake libpng libvorbis xorg-libxcursor xorg-libxpm xorg-libxxf86dga xorg-libxxf86vm

name=allegro
version=4.4.1.1
release=1
source=(http://downloads.sourceforge.net/project/alleg/$name/$version/$name-$version.tar.gz)

build() {
	cd $name-$version

	cmake \
		-DCMAKE_INSTALL_PREFIX=/usr \
		CMAKE_BUILD_TYPE=Release .

	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/doc
}
