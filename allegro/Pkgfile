# Description: A multi-platform game programming library for C/C++.
# URL: http://alleg.sourceforge.net/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: sten, nick dot steeves at shaw dot ca
# Depends on: alsa-lib xorg-libxcursor xorg-libxpm xorg-libxxf86dga xorg-libxxf86vm

name=allegro
version=4.2.2
release=2
source=(http://dl.sourceforge.net/sourceforge/alleg/$name-$version.tar.gz
	allegro-4.2.2-exec-stack.patch)

build() {
	cd $name-$version
	install -d $PKG/usr
	patch -p 0 -i $SRC/allegro-4.2.2-exec-stack.patch

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--enable-linux \
		--disable-asm \
		--disable-mmx \
		--disable-sse

	make -j 1
	make DESTDIR=$PKG install install-man
}
