# Description: Parser for multipart/form-data
# URL: https://multipart.readthedocs.io/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-wheel

name=python3-multipart
version=1.3.1
release=1
source=(https://pypi.org/packages/source/m/multipart/multipart-$version.tar.gz)

build() {
  cd multipart-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
