# Description: Tool for archiving and compressing old mails 
# URL: http://archivemail.sourceforge.net/
# Maintainer: Simon Gloﬂner, viper at hometux dot de
# Depends on: python

name=archivemail
version=0.7.0
release=1
source=(http://dl.sourceforge.net/$name/$name-$version.tar.gz)

build() {
    cd $name-$version

    mkdir -p $PKG/usr/bin
    mkdir -p $PKG/usr/man/man1
    
    install -m 755 archivemail $PKG/usr/bin/archivemail
    install -m 644 archivemail.1 $PKG/usr/man/man1
}
