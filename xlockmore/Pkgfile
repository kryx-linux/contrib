# Description: X Window System Lock Screen
# URL:         http://sillycycle.com/xlockmore.html
# Maintainer:  Thomas Penteker, tek at serverop dot de
# Packager:    Daniel Mueller, daniel at danm dot de
# Depends on:  gtk fortune xorg-libxt xorg-libxdamage

name=xlockmore
version=5.54
release=1
source=(http://sillycycle.com/xlock/xlockmore-${version}.tar.xz)

build() {
  cd $name-$version

  ./configure \
	--prefix=/usr \
	--sysconfdir=/etc \
	--enable-appdefaultdir=/etc/X11/app-defaults \
	--enable-vtlock \
	--enable-syslog \
	--enable-multiple-user \
	--enable-multiple-root \
	--without-motif \
	--with-opengl \
	--without-esound

  make
  make DESTDIR=$PKG install
}
