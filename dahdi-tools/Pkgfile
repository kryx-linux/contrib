# Description:	Digium Asterisk Hardware Device Interface Tools: userspace tools
# URL:		http://www.voip-info.org/wiki/view/DAHDI
# Maintainer:	Alan Mizrahi, alan at mizrahi dot com dot ve
# Depends on:	dahdi
# Optional:	newt

name=dahdi-tools
version=2.9.1
release=1
source=(http://downloads.asterisk.org/pub/telephony/$name/releases/$name-$version.tar.gz)

build () {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--mandir=/usr/man
	make
	make config install DESTDIR=$PKG install

	rm -rf $PKG/etc/bash_completion.d/

	# move udev rules to /lib/udev/rules.d
	mkdir $PKG/lib
	mv $PKG/etc/udev $PKG/lib/
	sed -i \
		-e 's|%E{DAHDI_TOOLS_ROOTDIR}||g' \
		-e 's|%E{XPP_INIT_DIR}/|/usr/share/dahdi/|g' \
		$PKG/lib/udev/rules.d/*
}
