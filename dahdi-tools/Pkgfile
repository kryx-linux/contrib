# Description:	Digium Asterisk Hardware Device Interface Tools
# URL:		http://www.voip-info.org/wiki/view/DAHDI
# Maintainer:	Alan Mizrahi, alan at mizrahi dot com dot ve
# Depends on:	dahdi
# Optional:	newt

name=dahdi-tools
version=2.6.2
release=1
source=(http://downloads.asterisk.org/pub/telephony/$name/releases/$name-$version.tar.gz dahdi-2.6.2.patch)

build () {
	cd $name-$version

	patch -p1 -i $SRC/dahdi-2.6.2.patch

	./configure --prefix=/usr --mandir=/usr/man
	make -j 1
	make -j 1 config install DESTDIR=$PKG install
}
