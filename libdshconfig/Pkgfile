name=libdshconfig
version=0.20.12
release=1
source=(http://www.netfort.gr.jp/~dancer/software/downloads/$name-$version.tar.gz)

build() {
	cd $name-$version
	./configure --prefix=$PKG/usr
	make && make install
	chown -R root:root $PKG
}

