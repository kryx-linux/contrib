# Description: GStreamer Multimedia Framework VA Plugins.
# URL: http://freedesktop.org/wiki/Software/vaapi/
# Maintainer: Danny Rawlins, crux at romster dot me
# Packager: Danny Rawlins, crux at romster dot me
# Depends on: gst-plugins-base gst-plugins-bad libva xorg-libxrandr libvpx

name=gstreamer-vaapi
version=0.6.0
release=1
source=(http://www.freedesktop.org/software/vaapi/releases/$name/$name-$version.tar.bz2)

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--disable-builtin-libvpx

	make
	make DESTDIR=$PKG install
}
