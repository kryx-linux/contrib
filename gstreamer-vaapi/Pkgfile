# Description: GStreamer Multimedia Framework VA Plugins.
# URL: http://freedesktop.org/wiki/Software/vaapi/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Danny Rawlins, monster dot romster at gmail dot com
# Depends on: gst-plugins-base gst-plugins-bad libva xorg-libxrandr git libvpx

name=gstreamer-vaapi
version=0.5.9pre
sversion=22dc8c42514e1d5d3f89d064e52b252f01fce54b
release=1
source=()

build() {
	cd $PKGMK_SOURCE_DIR
	if cd $name; then
		git pull --rebase git://gitorious.org/vaapi/$name/$name master
		git checkout $sversion
	else
		git clone git://gitorious.org/vaapi/$name/$name $name
		cd $name
		git checkout $sversion
	fi
	cp -r $PKGMK_SOURCE_DIR/$name $SRC

	cd $SRC/$name

	sed -i 's/^1.3)/1.4)/' configure.ac
	NO_CONFIGURE=1 ./autogen.sh

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--disable-builtin-libvpx

	make
	make DESTDIR=$PKG install
}
