# Description: GStreamer Multimedia Framework VA Plugins.
# URL: http://freedesktop.org/wiki/Software/vaapi/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Danny Rawlins, monster dot romster at gmail dot com
# Depends on: gst-plugins-base gst-plugins-bad libva xorg-libxrandr

name=gstreamer-vaapi
version=0.5.6
release=1
source=(http://www.freedesktop.org/software/vaapi/releases/$name/$name-$version.tar.bz2)

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--with-gstreamer-api=0.10

	make
	make DESTDIR=$PKG install
}
