# Depends on:   

name=muttprint
version=0.72
release=2
source=(http://dl.sourceforge.net/$name/$name-$version.tar.gz)

build() {
   cd $name-$version

   make \
      prefix=$PKG/usr \
      mandir=$PKG/usr/man install

   rm -rf \
      $PKG/usr/man/{cs,de,es,it} \
      $PKG/usr/share/$name/{Debian*,Gentoo*}

   chown -R root:root $PKG
}
