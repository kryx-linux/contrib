# Description: Python interface to xlib.
# URL: http://python-xlib.sourceforge.net
# Maintainer: Danny Rawlins, romster at shortcircuit dot net dot au
# Packager: Johannes Winkelmann, jw at tks6 dot net
# Depends on: python xorg-libx11

name=python-xlib
version=0.12
release=3
source=(http://dl.sourceforge.net/sourceforge/python-xlib/python-xlib-$version.tar.gz\
	display.py-encoding.diff python-xlib-$version-attr-err.diff)

build() {
	cd python-xlib-$version
	patch Xlib/protocol/display.py $SRC/display.py-encoding.diff
	patch -p1 -i ../python-xlib-$version-attr-err.diff
	python setup.py install --root=$PKG --prefix=/usr
}

