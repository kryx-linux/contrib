# Description: sip module for pyqt5
# URL: https://github.com/Python-SIP/sip
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-wheel

name=python3-pyqt5-sip
version=12.19.0
release=1
source=(https://pypi.python.org/packages/source/p/pyqt5_sip/pyqt5_sip-$version.tar.gz)

build() {
  cd pyqt5_sip-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
