# Description: xorg console
# URL:         http://xorg.freedesktop.org
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Depends on:  xorg-server

name=xorg-xconsole
version=1.0.2
release=1
source="http://xorg.freedesktop.org/releases/individual/app/xconsole-$version.tar.gz"

build()
{
    cd xconsole-$version
    ./configure --prefix=/usr
    make
    make install DESTDIR=$PKG
}
