# Description: XLib in pure Python
# URL: https://github.com/python-xlib/python-xlib
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-importlib_metadata python3-six

name=python3-xlib
version=0.33
release=3
source=(https://github.com/python-xlib/python-xlib/releases/download/$version/python-xlib-$version.tar.bz2
  setup.patch)

build() {
  cd python-xlib-$version

  patch -Np1 -i $SRC/setup.patch
  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
