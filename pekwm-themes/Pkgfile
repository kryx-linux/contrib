# Description: Pekwm themes collection 
# URL:  http://adrinux.wordpress.com
# Maintainer: Jose V Beneyto, sepen at users dot sourceforge dot net
# Packager: Jose V Beneyto, sepen at users dot sourceforge dot net
# Depends on: pekwm

name=pekwm-themes
version=1.0.4
release=1
source=(http://aur.archlinux.org/packages/$name/$name/$name-$version.tar.gz)

build() {
  install -d $PKG/usr/share/pekwm
  mv themes $PKG/usr/share/pekwm
  find $PKG -type d -exec chmod 0755 {} \;
  find $PKG -type f -exec chmod 0644 {} \;
}
