# Description: The Versatile Commodore Emulator
# Maintainer: Matt Housh, jaeger at crux dot ninja
# URL: https://vice-emu.sourceforge.io/
# Depends on: dos2unix xa glew gtk3 xorg-libevdev pulseaudio

name=vice
version=3.10
release=1
source=(https://sourceforge.net/projects/vice-emu/files/releases/$name-$version.tar.gz)

build() {
  cd $name-$version
  ./configure --prefix=/usr
  make
  make DESTDIR=$PKG install
}
