# Description: Python version of Google's common library for parsing, formatting, storing and validating international phone numbers
# URL: https://github.com/daviddrysdale/python-phonenumbers
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-wheel

name=python3-phonenumbers
version=9.0.10
release=1
source=(https://github.com/daviddrysdale/python-phonenumbers/archive/r$version/$name-$version.tar.gz)

build() {
  cd python-phonenumbers-r$version/python

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
