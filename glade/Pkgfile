# Description: GTK Interface Builder.
# URL: https://glade.gnome.org/
# Maintainer: Danny Rawlins, crux at romster dot me
# Depends on: gtk3 itstool
# Optional: webkitgtk gtk-doc python3-gobject

name=glade
version=3.38.0
release=1
source=(
	#https://ftp.gnome.org/pub/GNOME/sources/$name/${version::4}/$name-$version.tar.xz
	https://gitlab.gnome.org/GNOME/glade/-/archive/3907987d318875fae551ca9a2bce97f33749d230/glade-3907987d318875fae551ca9a2bce97f33749d230.tar.bz2)

build() {
	prt-get isinst gtk-doc || PKGMK_GLADE+=' -D man=false'
	meson setup build $name-3907987* ${PKGMK_GLADE} \
		--prefix=/usr \
		--buildtype=plain \
		-Db_ndebug=true
	meson compile -C build -j ${JOBS-1}
	DESTDIR=$PKG meson install -C build

	rm -r $PKG/usr/share/{help,locale}
}
