name=streamlink
version=0.1.0
release=1
source=(https://pypi.python.org/packages/4f/6d/4841879cb0f906a746fca626f7014921b4d899f5cb1fc2a3c560f637f548/streamlink-0.1.0.tar.gz)

build() {
