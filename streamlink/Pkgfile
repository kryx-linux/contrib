# Description: A CLI utility that pipes videos from online streaming services to a variety of video players.
# URL: https://pypi.python.org/pypi/streamlink/
# Maintainer: Danny Rawlins, crux at romster dot me
# Packager: Danny Rawlins, crux at romster dot me
# Depends on: futures pycryptodome requests singledispatch

name=streamlink
version=0.2.0
release=1
source=(https://pypi.python.org/packages/2e/5c/5295b70f302ee068526cb860ad361df8796e4f1dfaa3bcacfaabb4859efe/streamlink-0.2.0.tar.gz)

build() {
	cd $name-$version
	/usr/bin/python setup.py build
	/usr/bin/python setup.py install --root=$PKG --optimize=1
}
