# Description: a glib-based library to use and manage the QRTR bus
# URL: https://modemmanager.org/docs/libqrtr-glib/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: glib-introspection

name=libqrtr-glib
version=1.4.0
release=1
source=(https://gitlab.freedesktop.org/mobile-broadband/libqrtr-glib/-/archive/$version/$name-$version.tar.bz2)

build() {
  meson setup $name-$version build \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true \
    -D gtk_doc=false
  meson compile -C build
  DESTDIR=$PKG meson install -C build
}
