# Description: Fast, disk space efficient package manager
# URL: https://github.com/pnpm/pnpm
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: npm

name=pnpm
version=12.18.0
release=1
source=(https://registry.npmjs.org/pnpm/-/pnpm-$version.tgz)

build() {
  cp $PKGMK_SOURCE_DIR/$name-$version.tgz .

  npm install -g \
    --prefix $PKG/usr \
    --ignore-scripts \
    $SRC/$name-$version.tgz

  cd "$PKG/usr/lib/node_modules/pnpm"
  node install.js

  $PKG/usr/bin/pnpm --version

  find $PKG \(\
    -iname "*README.md*" -o \
    -iname "*CHANGELOG.md*" -o \
    -iname "*.map" -o \
    -iname "*.md" -o \
    -iname "*.cmd" -o \
    -iname "*.bat" -o \
    -iname "*LICENSE*" \) -delete
}
