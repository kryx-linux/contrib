# Description: An implementation of AsciiDoc in Ruby
# Maintainer: Juergen Daubertm jue at crux dot nu
# URL: https://asciidoctor.org/
# Depends on: ruby

name=asciidoctor
version=2.0.20
release=2
source=(https://rubygems.org/downloads/$name-$version.gem)

build() {
	gem install $name \
		--ignore-dependencies \
		--no-user-install \
		--no-document \
		--local \
		--build-root $PKG

	cd $PKG/$(gem env gemdir)
	rm -r cache doc build_info extensions
	cd gems/$name-$version
	rm CHANGELOG* LICENSE README*
	install -D -m 0644 man/$name.1 $PKG/usr/share/man/man1/$name.1
}
