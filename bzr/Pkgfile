# Depends on:  python

name=bzr
version=0.14
release=2
source=(http://bazaar-vcs.org/releases/src/$name-$version.tar.gz)

build() {
   cd $name-$version 
   python setup.py install --root=$PKG --prefix=/usr
   chown root:root $PKG
}
