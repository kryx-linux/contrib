#!/bin/sh
#
# /etc/rc.d/lighttpd: start/stop lighttpd daemon
#

case $1 in
start)
  /usr/sbin/lighttpd -f /etc/lighttpd.conf
  ;;
stop)
  if [ -f /var/run/lighttpd.pid ]; then
    kill `cat /var/run/lighttpd.pid`
    rm -f /var/run/lighttpd.pid
  fi
  ;;
restart)
  $0 stop
  sleep 2
  $0 start
  ;;
*)
  echo "usage: $0 [start|stop|restart]"
  ;;
esac

# End of file
