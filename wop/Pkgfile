# Description:	Real-time Worms game for Linux.
# URL:			http://wormsofprey.org/
# Maintainer:	James Mills prologic at shortcircuit dot net dot au
# Packager:		James Mills prologic at shortcircuit dot net dot au
#
# Depends on:	sdl_net, sdl_mixer, sdl_image, sdl_ttf

name=wop
version=0.4.3
release=1
source=(http://wormsofprey.org/download/$name-$version-src.tar.bz2 \
	http://wormsofprey.org/download/wopdata-2005-12-21.tar.bz2 \
	$name-client $name-server)

build() {
	cd $name-$version
	make clean
	make
	install -d $PKG/usr/share/$name
	cp -r $SRC/wopdata-2005-12-21/* $PKG/usr/share/$name/
	install -D -m755 bin/$name $PKG/usr/bin/$name
	install -D -m755 $SRC/$name-client $PKG/usr/bin/$name-client
	install -D -m755 $SRC/$name-server $PKG/usr/bin/$name-server
	chown -R root:root $PKG
}
