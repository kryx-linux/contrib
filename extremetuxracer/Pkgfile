# Description: Downhill racing game starring Tux.
# URL: http://extremetuxracer.com/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Danny Rawlins, monster dot romster at gmail dot com
# Depends on: freetype glu libpng sdl_image sdl_mixer tcl xorg-libxi xorg-libxmu

name=extremetuxracer
version=0.6.0
release=1
source=(http://downloads.sourceforge.net/project/$name/releases/$version/etr-$version.tar.xz)

build() {
	cd etr-$version

	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
