# Description: Downhill racing game starring Tux.
# URL: http://extremetuxracer.com/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Danny Rawlins, monster dot romster at gmail dot com
# Depends on: freetype libpng sdl_mixer tcl xorg-libxi xorg-libxmu

name=extremetuxracer
version=0.5beta
release=1
source=(http://downloads.sourceforge.net/project/$name/extreme-tuxracer/$version/$name-$version.tar.gz)

build() {
	cd extreme-tuxracer-$version
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share/locale
}
