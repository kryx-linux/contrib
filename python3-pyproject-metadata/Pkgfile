# Description: PEP 621 metadata parsing
# URL: https://github.com/FFY00/python-pyproject-metadata
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-flit-core python3-build python3-wheel python3-installer

name=python3-pyproject-metadata
version=0.7.1
release=1
source=(https://pypi.org/packages/source/p/pyproject-metadata/pyproject-metadata-$version.tar.gz)

build() {
  cd pyproject-metadata-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
