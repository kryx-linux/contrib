# Description: break a wavfiles  up into multiple wave files. with nice gui
# URL:         http://huli.org/wavbreaker
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  gtk libxml

name=wavbreaker
version=0.7
release=1
source="http://huli.org/$name/$name-$version.tar.gz"

build()
{
    cd $name-$version
    ./configure \
        --prefix=/usr \
        --disable-nls
    make
    make install DESTDIR=$PKG
}
