# Description: A userspace library providing interface to packets that have been logged by the kernel packet filter.
# URL: https://netfilter.org/projects/libnetfilter_log/
# Maintainer: Danny Rawlins, crux at romster dot me
# Packager: Beneyto, Jose V at dot dot net sepen sourceforge users
# Depends on: libmnl libnfnetlink

name=libnetfilter_log
version=1.0.2
release=1
source=(http://www.netfilter.org/projects/$name/files/$name-$version.tar.bz2)

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--disable-static

	make
	make DESTDIR=$PKG install
}
