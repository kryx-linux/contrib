# Description: A userspace library providing interface to packets that have been logged by the kernel packet filter
# URL: https://netfilter.org/projects/libnetfilter_log/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: libmnl libnfnetlink

name=libnetfilter_log
version=1.0.2
release=1
source=(https://www.netfilter.org/projects/$name/files/$name-$version.tar.bz2)

build() {
  cd $name-$version

  ./configure \
    --prefix=/usr \
    --disable-static

  make
  make DESTDIR=$PKG install
}
