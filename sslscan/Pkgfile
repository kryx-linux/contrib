name=sslscan
version=1.8.2
release=1
source=(http://downloads.sourceforge.net/project/sslscan/sslscan/sslscan-$version.tgz)

build() {
	cd $name-$version
  make LDFLAGS=-lcrypto

  install -m 755 -d $PKG/usr/bin $PKG/usr/man/man1
  make install MANPATH=$PKG/usr/man/ BINPATH=$PKG/usr/bin
}
