name=p5-xml-twig
version=3.29
release=1
source=(http://xmltwig.com/xmltwig/XML-Twig-$version.tar.gz)

build() {
   cd XML-Twig-$version
   yes | perl Makefile.PL PREFIX=$PKG/usr
   make && make install
   find $PKG -name "perllocal.pod" -exec rm {} \;
   chown -R root:root $PKG
}
