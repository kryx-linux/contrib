# Description: Collection of free plugins compatible with LADSPA, LV2 and LinuxVST
# URL: https://lsp-plug.in
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: cairo jack ladspa lv2 mesa php util-linux

name=lsp-plugins
version=1.2.0
release=1
source=(https://github.com/sadko4u/lsp-plugins/releases/download/$version/$name-src-$version.tar.gz)

build() {
  cd $name
  make config PREFIX=/usr SHARE_PATH=/usr/share FEATURES='jack ladspa lv2 vst2 xdg'
  make
  make DESTDIR=$PKG install
  #BIN_PATH=/usr/bin \
  #  LIB_PATH=/usr/lib \
  #  SHARE_PATH=/usr/share \
  #  DESTDIR="$PKG/" \
  #  install
  rm -fr $PKG/usr/share/doc
}
