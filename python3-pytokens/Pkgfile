# Description: A Fast, spec compliant Python 3.12+ tokenizer that runs on older Pythons
# URL: https://github.com/tusharsadhwani/pytokens
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-setuptools

name=python3-pytokens
version=0.1.10
release=1
source=(https://pypi.org/packages/source/p/pytokens/pytokens-$version.tar.gz)

build() {
  cd pytokens-$version

  /usr/bin/python3 setup.py build
  /usr/bin/python3 setup.py install --prefix=/usr \
    --root=$PKG \
    --skip-build
}
