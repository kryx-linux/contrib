# Description: A Fast, spec compliant Python 3.12+ tokenizer that runs on older Pythons
# URL: https://github.com/tusharsadhwani/pytokens
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-mypy python3-mypy-extensions

name=python3-pytokens
version=0.4.0
release=1
source=(https://pypi.org/packages/source/p/pytokens/pytokens-$version.tar.gz)

build() {
  cd pytokens-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
