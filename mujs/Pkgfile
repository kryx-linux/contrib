# Description: Lightweight Javascript interpreter
# URL: https://mujs.com
# Maintainer:  Tim Biermann, tbier at posteo dot de

name=mujs
version=1.3.9
release=1
source=(https://mujs.com/downloads/$name-$version.tar.gz 010-mujs-use-arch-flags.patch)

build() {
  cd $name-$version

  patch -Np1 -i $SRC/010-mujs-use-arch-flags.patch
  make release
  make prefix=/usr DESTDIR=$PKG install-static install-shared

  sed -i -e "s/^Version:.*/Version: $version/" $PKG/usr/lib/pkgconfig/$name.pc
}
