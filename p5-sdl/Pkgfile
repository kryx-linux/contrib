# Description: Simple DirectMedia Layer for Perl
# URL: http://sdl.perl.org/
# Maintainer: John McQuah, jmcquah at disroot dot org
# Depends on: p5-alien-build p5-alien-sdl p5-tie-simple sdl_gfx sdl_image sdl_mixer sdl_net sdl_pango sdl_ttf

name=p5-sdl
## https://metacpan.org/release/SDL
_author=FROGGS
version=2.548
release=2
source=(https://cpan.metacpan.org/authors/id/${_author::1}/${_author::2}/$_author/SDL-$version.tar.gz
	surface-xs-calc-offset.patch)

build() {
	cd SDL-$version

	# replace deprecated macro
	sed -i "s/sv_nv/SvNVx/" src/SDLx/Controller/Interface.xs

	# declare calc_offset earlier
	patch -p1 -i $SRC/surface-xs-calc-offset.patch

	# avoid undefined import
	sed -i "/File::Spec/s/ 'catfile'//" t/00-load.t
	sed -i "/SDLx::Music/s/,.*)/)/" t/sdlx_music.t

	perl Build.PL installdirs=vendor
	perl Build
	perl Build install destdir="$PKG"

	find $PKG \( -name '.packlist' -o -name '*.pod' \) -delete
	find $PKG -depth -empty -delete

	# fix perms
	find $PKG -type f -a ! -perm -u+w -exec chmod u+w '{}' +
}
