# Description:	VNC server for real X displays
# URL:		http://www.karlrunge.com/x11vnc/
# Maintainer:	Alan Mizrahi, alan at mizrahi dot com dot ve
# Depends on:	libjpeg xorg-libx11 xorg-libxau xorg-libxcb xorg-libxdamage xorg-libxdmcp xorg-libxext xorg-libxfixes xorg-libxinerama xorg-libxrandr xorg-libxrender xorg-libxtst

name=x11vnc
version=0.9.7
release=1
source=(http://prdownloads.sf.net/libvncserver/$name-$version.tar.gz)

build() {
	cd $name-$version
	./configure --prefix=/usr \
		    --disable-nls \
		    --mandir=$PKG/usr/man
	make
	make prefix=$PKG/usr install
	rm -rf $PKG/usr/share
}
