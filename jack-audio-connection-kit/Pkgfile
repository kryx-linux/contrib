# Description: A real-time, low latency audio daemon.
# URL: http://jackaudio.org/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Jay Dolan, jdolan at jdolan dot dyndns dot org
# Depends on: libsndfile libsamplerate

name=jack-audio-connection-kit
version=0.116.2
release=1
source=(http://jackaudio.org/downloads/$name-$version.tar.gz)

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--disable-portaudio

	make
	make DESTDIR=$PKG install
	rm -rf $PKG/usr/share
}
