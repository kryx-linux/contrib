# Description: A utility to find python versions on your system
# URL: https://github.com/frostming/findpython
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-pdm-backend python3-platformdirs

name=python3-findpython
version=0.7.1
release=1
source=(https://pypi.org/packages/source/f/findpython/findpython-$version.tar.gz)

build() {
  cd findpython-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
