# Description: Recover lost partitions and files. 
# URL: http://www.cgsecurity.org/wiki/TestDisk
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Hannes Mayer, kontakt at ecarux dot de
# Depends on: ntfsprogs libjpeg

name=testdisk
version=6.11
release=2
source=(http://www.cgsecurity.org/$name-$version.tar.bz2
	http://www.cgsecurity.org/photorec_611_exif_bound_checking_v2.patch)

build() {
	cd $name-$version

	patch -p 1 -i $SRC/photorec_611_exif_bound_checking_v2.patch

	./configure \
		--prefix=/usr \
		--mandir=/usr/man

	make 
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share
}
