name=sysstat
version=7.1.5
release=1
source=(http://perso.orange.fr/sebastien.godard/$name-$version.tar.gz)

build() {
  cd $name-$version
  ./configure --prefix=/usr

  make
  make DESTDIR=$PKG install

  rm -rf $PKG/etc/sysconfig
  rm -rf $PKG/usr/{doc,share}
}
