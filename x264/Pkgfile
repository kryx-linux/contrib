# Description: Library for encoding H264/AVC video streams (snapshot).
# URL: http://www.videolan.org/developers/x264.html
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Rouven Schuerch, rs at tegonal dot com
# Depends on: yasm

name=x264
version=20130201
release=1
source=(http://crux.ster.so/distfiles/$name/$name-$version-bc13772.tar.xz)

build() {
	cd $name

	./configure \
		--prefix=/usr \
		--enable-pic \
		--enable-shared

	make
	make DESTDIR=$PKG install
	chmod a-x $PKG/usr/lib/*.so
}
