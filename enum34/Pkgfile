name=enum34
version=1.1.6
release=1
source=(https://pypi.python.org/packages/bf/3e/31d502c25302814a7c2f1d3959d2a3b3f78e509002ba91aea64993936876/$name-$version.tar.gz)

build() {
	cd $name-$version

	/usr/bin/python setup.py build
