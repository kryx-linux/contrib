#!/bin/sh
. /etc/pkgmk.conf
e17_packages="eet edb evas ecore embryo edje epeg epsilon emotion esmart ewl entice entrance iconbar e17 e_modules e_utils engrave"
for i in $e17_packages; do
    rm $PKGMK_PACKAGE_DIR/$i\#cvs-1.pkg.tar.gz
done
prt-get remove $e17_packages
prt-get depinst e17  engrave e_modules e_utils

echo "git commit -m 'e17:rebuild all relevant ports' {$(echo $e17_packages|tr " " ",")}/*"
