# Description: Provides useful functions found on BSD systems
# URL:         http://libbsd.freedesktop.org/
# Maintainer:  Svyatoslav Mishyn, juef at openmailbox dot org

name=libbsd
version=0.8.3
release=1
source=(http://libbsd.freedesktop.org/releases/$name-$version.tar.xz)

build() {
	cd $name-$version
	./configure --prefix=/usr
	make
	make install DESTDIR=$PKG
}
