#
# Depends on:

name=htmldoc
version=1.8.27
release=2
source=(http://ftp.easysw.com/pub/$name/$version/$name-$version-source.tar.bz2)

build() {
   cd $name-$version
   ./configure --prefix=/usr
   make
   make  prefix=$PKG/usr bindir=$PKG/usr/bin install
   rm -rf $PKG/usr/share/doc
}
