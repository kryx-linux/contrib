name=md5deep
version=2.0.1
release=1
source=(http://dl.sourceforge.net/${name}/${name}-${version}-001.tar.gz)

build() {
  cd ${SRC}/$name-$version-001
	./configure --prefix=/usr
  make || return 1
#  make BIN=${PKG}/usr/bin MAN=${PKG}/usr/man/man/man1 install
	make DESTDIR=$PKG install
}
