# Description: A fast desktop menu
# URL: https://github.com/enkore/j4-dmenu-desktop
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: spdlog

name=j4-dmenu-desktop
version=3.1
release=1
source=(https://github.com/enkore/j4-dmenu-desktop/archive/r$version/$name-$version.tar.gz)

build() {
  meson setup $name-r$version build \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true \
    -D enable-tests=false
  meson compile -C build
  DESTDIR=$PKG meson install -C build

  if ! prt-get isinst bash-completion; then rm -r $PKG/usr/share/bash-completion; fi
  if ! prt-get isinst fish; then rm -r $PKG/usr/share/fish; fi
  if ! prt-get isinst zsh; then rm -r $PKG/usr/share/zsh; fi
}
