# Description: A fast desktop menu
# URL: https://github.com/enkore/j4-dmenu-desktop
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: cmake

name=j4-dmenu-desktop
version=2.18
release=1
source=(https://github.com/enkore/j4-dmenu-desktop/archive/r$version/$name-$version.tar.gz)

build() {
  [[ -e /usr/bin/ninja ]] && PKGMK_J4DD_OPTIONS=' -GNinja'
  cmake -S$name-r$version -Bbuild $PKGMK_J4DD_OPTIONS \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DWITH_TESTS="no"
  cmake --build build
  DESTDIR=$PKG cmake --install build
}
