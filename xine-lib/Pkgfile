# Description: A free, GPL-licensed video player for UNIX-like systems.
# URL: http://xine.sourceforge.net
# Maintainer: Danny Rawlins, romster at shortcircuit dot net dot au
# Packager: sten, nick dot steeves at shaw dot ca
# Depends on: xorg-libxvmc faad2 flac gdk-pixbuf liba52 libmad libmng libsdl speex libtheora wavpack libmpcdec libdvdnav vcdimager

name=xine-lib
version=1.1.5
release=1
source=(http://dl.sourceforge.net/sourceforge/xine/xine-lib-$version.tar.bz2)

build() {
	unset CFLAGS CXXFLAGS
	cd xine-lib-$version
	
	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--disable-nls \
		--disable-oss \
		--enable-antialiasing \
		--enable-ipv6 \
		--enable-modplug \
		--with-libflac \
		--with-wavpack \
		--with-external-dvdnav \
		--with-external-libmpcdec \
		--with-external-a52dec \
		--with-external-libmad


	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share/doc
}

