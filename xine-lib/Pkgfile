# Description: A free, GPL-licensed video player for UNIX-like systems.
# URL: http://xine.sourceforge.net
# Maintainer: Danny Rawlins, romster at shortcircuit dot net dot au
# Packager: sten, nick dot steeves at shaw dot ca
# Depends on: faad2, flac, gdk-pixbuf, liba52, libdvdnav, libmad, libmng, libsdl, speex, libtheora

name=xine-lib
version=1.1.3
release=1
source=(http://dl.sourceforge.net/sourceforge/xine/$name-$version.tar.gz)

build() {
	unset CFLAGS CXXFLAGS
	cd $name-$version
	
	./configure \
		--prefix=/usr \
		--disable-nls \
		--mandir=/usr/man \
		--enable-ipv6

	make && make DESTDIR=$PKG install
	rm -r $PKG/usr/share/doc
}

