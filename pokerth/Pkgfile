# Description: Poker Texas Holdem game
# URL: http://www.pokerth.net/ 
# Maintainer: Victor Martinez, pitillo at ono dot com
# Depends on: qt4 sdl_mixer boost gnutls 

name=pokerth
version=0.7.1
release=1
source=(http://dl.sourceforge.net/project/$name/$name/0.7/PokerTH-$version-src.tar.bz2)

build() {
  cd PokerTH-$version-src
  qmake pokerth.pro
  make
  make INSTALL_ROOT=$PKG install
  mkdir $PKG/usr/bin/
  cp $SRC/PokerTH-$version-src/pokerth $PKG/usr/bin/
}
