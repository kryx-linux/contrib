# Description: Pickled object field for Django
# URL: https://github.com/gintas/django-picklefield
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Depends on: python3-django

name=python3-django-picklefield
version=3.4.0
release=1
source=(https://pypi.org/packages/source/d/django_picklefield/django_picklefield-$version.tar.gz)

build() {
  cd django_picklefield-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
