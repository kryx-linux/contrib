# Description: RAID-like data-recovery for multi-part archives
# URL:         http://parchive.sf.net
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  

name=parchive
version=0.4
release=1

source="http://dl.sourceforge.net/sourceforge/$name/par2cmdline-$version.tar.gz"

build()
{
    cd par2cmdline-$version
    ./configure \
        --prefix=/usr
    make
    install -D par2 $PKG/usr/bin/$name
}
