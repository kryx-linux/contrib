# Description: Recursive copy of nested objects
# URL: https://metacpan.org/pod/Clone
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on:

name=p5-clone
version=0.48
release=1
source=(https://cpan.metacpan.org/authors/id/A/AT/ATOOMIC/Clone-$version.tar.gz)

unpack_source() {
  mkdir -p $SRC/tarballs $SRC/$name-$version/external/tarballs
  for file in ${source[@]}; do
    case ${file##*/} in
    Clone-$version.tar.gz)
      echo "Unpacking $(get_filename $file)"
      bsdtar -p -o -C $SRC -xf $(get_filename $file)
      ;;
    *)
      cp $(get_filename $file) $SRC
      ;;
    esac
  done
}

build() {
  cd Clone-$version
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
  make DESTDIR=$PKG install
  find $PKG -name .packlist -o \
    -name perllocal.pod -o \
    -name README -o \
    -name '*.bs' | xargs rm
}
