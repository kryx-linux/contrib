name=ethtool
version=6
release=1
source=(http://dl.sourceforge.net/sourceforge/gkernel/$name-$version.tar.gz)

build() {
  cd $name-$version
  ./configure --prefix=/usr
  make
  make DESTDIR=$PKG install
}

