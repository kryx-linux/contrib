name=ethtool
version=2.6.33
release=1
source=(http://dl.sourceforge.net/sourceforge/gkernel/$name-$version.tar.gz)

build() {
  cd $name-$version

  ./configure --prefix=/usr \
              --mandir=/usr/man

  make
  make DESTDIR=$PKG install
}

