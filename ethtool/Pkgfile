name=ethtool
version=4.11
release=1
source=(https://www.kernel.org/pub/software/network/$name/$name-$version.tar.xz)

build() {
  cd $name-$version
  ./configure --prefix=/usr
  make
  make DESTDIR=$PKG install
}

