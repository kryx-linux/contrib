name=ethtool
version=3
release=1
source="http://dl.sourceforge.net/sourceforge/gkernel/$name-$version.tar.gz"

build() {
    cd $name-$version
    ./configure \
        --prefix=/usr \
        --disable-nls
    make
    make install DESTDIR=$PKG
}
