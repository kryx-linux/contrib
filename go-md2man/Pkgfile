# Description: Converts markdown into roff (man pages)
# URL: https://github.com/cpuguy83/go-md2man
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: go

name=go-md2man
version=2.0.6
release=1
source=(https://github.com/cpuguy83/go-md2man/archive/v$version/$name-$version.tar.gz)

build() {
  cd $name-$version

  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"

  mkdir "$PKGMK_SOURCE_DIR/gopath" || true
  export GOPATH="$PKGMK_SOURCE_DIR/gopath"

  go build \
    -trimpath \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -o $name .
  ./go-md2man -in=go-md2man.1.md -out=go-md2man.1

  install -Dm755 go-md2man "$PKG/usr/bin/go-md2man"
  install -Dm755 go-md2man.1 "$PKG/usr/share/man/man1/go-md2man.1"
}
