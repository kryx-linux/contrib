# Description: mirabiles version of OpenBSD's version of pdksh
# URL:         http://mirbsd.de/mksh/
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:

name=mksh
version=28
release=1
source="http://www.mirbsd.org/MirOS/dist/mir/mksh/mksh-R$version.cpio.gz"

build()
{
    gzip -dc mksh-R*.cpio.gz | cpio -mid
    cd mksh
    sh Build.sh -d -r
    install -D mksh          $PKG/bin/mksh
    install -D mksh.1 -m 644 $PKG/usr/man/man1/mksh.1
}
