# Description: An open source JPEG 2000 codec.
# URL: https://github.com/uclouvain/openjpeg
# Maintainer: Danny Rawlins, crux at romster dot me
# Depends on: lcms2 libpng

name=openjpeg2
version=2.3.1
release=1
source=(https://github.com/uclouvain/openjpeg/archive/v$version/openjpeg-$version.tar.gz)

build() {
	[[ -e /usr/bin/ninja ]] && PKGMK_OJPG2_OPTIONS=' -GNinja'
	cmake -Sopenjpeg-$version -Bbuild $PKGMK_OJPG2_OPTIONS \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS -DNDEBUG" \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS -DNDEBUG" \
		-Wno-dev

	# cmake --build/install fails
	make -C build
	make DESTDIR=$PKG -C build install
}
