# Description: Common development macros for GNOME
# URL: https://git.gnome.org/browse/gnome-common
# Maintainer: Tim Biermann, tbier at posteo dot de

name=gnome-common
version=3.18.0
release=2
source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz)

build() {
  cd $name-$version

  sed -i '/autoreconf --verbose --force --install -Wno-portability/ s|-Wno-portability|& -I /usr/share/gettext/m4|' macros2/gnome-autogen.sh

  ./autogen.sh
  ./configure \
    --prefix=/usr
  make
  make DESTDIR=$PKG install
}
