# Description: QMI modem protocol helper library
# URL: https://www.freedesktop.org/wiki/Software/libqmi/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: libgudev libmbim libqrtr-glib
# Optional: bash-completion help2man

name=libqmi
version=1.36.0
release=1
source=(https://gitlab.freedesktop.org/mobile-broadband/libqmi/-/archive/$version/libqmi-$version.tar.bz2)

build() {
  prt-get isinst bash-completion || PKGMK_LIBQMI+=' -D bash_completion=false'
  prt-get isinst help2man || PKGMK_LIBQMI+=' -D man=false'

  meson setup $name-$version build $PKGMK_LIBQMI \
    --prefix=/usr \
    --libexecdir=/usr/lib/$name \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true
  meson compile -C build
  DESTDIR=$PKG meson install -C build --no-rebuild
}
