# Description: Fast and user-friendly Conway's Life program
# URL:         http://www.igs.net/~tril/$name/
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  gtk1

name=gtklife
version=5.1
release=1
source="http://ironphoenix.org/tril/gtklife/$name-$version.tar.gz"

build()
{
    cd $name-$version
    ./configure --prefix=/usr
    make
    make install prefix=$PKG/usr
    rm -r $PKG/usr/doc/
}
