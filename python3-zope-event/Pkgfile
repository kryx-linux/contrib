# Description: Provides a simple event system
# URL: https://github.com/zopefoundation/zope.event
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-wheel

name=python3-zope-event
version=6.2
release=1
source=(https://pypi.org/packages/source/z/zope_event/zope_event-$version.tar.gz)

build() {
  cd zope_event-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
