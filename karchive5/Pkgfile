name=karchive5
version=5.109.0
release=1
source=(http://download.kde.org/stable/frameworks/${version%.0}/karchive-$version.tar.xz)

build() {
  cmake -S karchive-$version -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr/opt/$name \
    -D CMAKE_INSTALL_LIBDIR=lib \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
    -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	-D BUILD_TESTING=OFF \
    -Wno-dev
  cmake --build build
  DESTDIR=$PKG cmake --install build

  rm -rf $PKG/usr/share/locale

  echo "/usr/opt/karchive5/lib" > $SRC/karchive5.conf
  install -Dt $PKG/etc/ld.so.conf.d $SRC/karchive5.conf
}
