# Description: A set of plugins for gstreamer that may pose distribution problems.
# URL: http://gstreamer.freedesktop.org/modules/gst-plugins-bad.html
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Matt Housh, jaeger at morpheus dot net
# Depends on: curl e2fsprogs faad2 gst-plugins-base1 krb5 libdca libdvdnav libmms mjpegtools mpg123 neon

name=gst-plugins-bad1
version=1.0.10
release=2
source=(http://gstreamer.freedesktop.org/src/gst-plugins-bad/gst-plugins-bad-$version.tar.xz)

build() {
	cd gst-plugins-bad-$version

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--enable-experimental \
		--disable-debug \
		--disable-nls \
		--disable-dependency-tracking \
		--disable-valgrind \
		--disable-examples

	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share/gtk-doc
}
