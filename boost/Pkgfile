# Depends on: python

name=boost
version=1.34.0
release=2
source=(http://dl.sourceforge.net/sourceforge/boost/boost_${version//./_}.tar.bz2)

build() {
	cd boost_${version//./_}
	./configure --prefix=$PKG/usr
	make
	#make check
	make install
	local version=${version%.*}
	ln -sf /usr/include/boost-${version//./_}/boost/ $PKG/usr/include/boost
}

