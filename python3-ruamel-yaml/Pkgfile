# Description: ruamel.yaml is a YAML parser/emitter that support comment preservation
# URL: https://sourceforge.net/projects/ruamel-yaml/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-ruamel-yaml-clib

name=python3-ruamel-yaml
version=0.18.17
release=1
source=(https://pypi.org/packages/source/r/ruamel_yaml/ruamel_yaml-$version.tar.gz)

build() {
  cd ruamel.yaml-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
