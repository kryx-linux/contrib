# Description:	A real-time strategy game.
# URL: http://wz2100.net/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Mark Rosenstand, mark at borkware dot net
# Depends on: libjpeg libmad libpng openal physfs sdl_net smpeg libvorbis popt quesoglc x11-fonts-dejavu

name=warzone2100
version=2.2.2
release=1
source=(http://download.gna.org/warzone/releases/${version%.*}/$name-$version.tar.gz)

build() {
	cd $name-$version
	./autogen.sh

	./configure \
		--prefix=/usr \
		--disable-nls

	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share/doc
}
