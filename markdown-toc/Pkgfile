# Description: API and CLI for generating a markdown TOC (table of contents)
# URL: https://github.com/jonschlinkert/markdown-toc
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: npm

name=markdown-toc
version=1.2.0
release=1
source=(https://registry.npmjs.org/$name/-/$name-$version.tgz)

build() {
  cp $PKGMK_SOURCE_DIR/$name-$version.tgz .
  npm install -g --prefix $PKG/usr $SRC/$name-$version.tgz

  find $PKG \(\
    -iname "*README.md*" -o \
    -iname "*CHANGELOG.md*" -o \
    -iname "*LICENSE*" \) -delete
}
