name=postgresql
version=9.0.4
release=1
source=(ftp://ftp9.de.postgresql.org/unix/databases/postgresql/source/v$version/$name-$version.tar.bz2 postgresql)

build() {
  cd $name-$version

  ./configure --prefix=/usr --disable-nls --mandir=$PKG/usr/man
  make
  make DESTDIR=$PKG install

  cd doc/src/sgml
  make install-man
  rm -rf $PKG/usr/share/doc

  mkdir -p $PKG/etc/rc.d/
  install -D -m 755 $SRC/postgresql $PKG/etc/rc.d/postgresql
}
