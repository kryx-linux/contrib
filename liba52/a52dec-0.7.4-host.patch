 AC_CONFIG_SRCDIR([src/a52dec.c])
 AC_CONFIG_AUX_DIR(autotools)
 AC_CONFIG_FILES([Makefile autotools/Makefile include/Makefile test/Makefile
@@ -32,15 +33,9 @@ if test x"$GCC" = x"yes"; then
 
