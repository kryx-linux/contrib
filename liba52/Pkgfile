# Description: Library for decoding ATSC A/52 streams.
# URL: http://liba52.sourceforge.net/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Matt Housh, jaeger at morpheus dot net

name=liba52
version=0.7.4
release=3
source=(http://liba52.sourceforge.net/files/a52dec-$version.tar.gz
	a52dec-0.7.4-host.patch)

build() {
	cd a52dec-$version

	patch -p 1 -i $SRC/a52dec-0.7.4-host.patch
	./bootstrap

	./configure \
		--prefix=/usr \
		--mandir=$PKG//usr/man \
		--disable-solaris-audio \
		--disable-win \
		--disable-static \
		--enable-shared \
		--enable-double

	make
	make install prefix=$PKG/usr

        # required for xine-lib
        install -m644 liba52/a52_internal.h $PKG/usr/include/a52dec/
}
