# Description: A screen manager with VT100/ANSI terminal emulation
# URL:         http://www.gnu.org/software/screen/
# Packager:    Jürgen Daubert, juergen dot daubert at t-online dot de
# Maintainer:  Han Boetes <han@mijncomputer.nl>

name=screen
version=4.0.3
release=1
source="ftp://ftp.uni-erlangen.de/pub/utilities/$name/$name-$version.tar.gz"

build()
{
    cd $name-$version
    export TERMINFO=$PKG/usr/share/terminfo
    ./configure --prefix=/usr --enable-colors256
    make
    make DESTDIR=$PKG install
    rm -rf $PKG/usr/{info,share/terminfo}
    # Running screen SUID root enables you to allow multiple users
    # to connect to a single screen session. So do we need suid?
    # NOOOOOOOOOOOOOO. Just log in as the same user.
    mv $PKG/usr/bin/screen{-$version,}
    chmod 0755 $PKG/usr/bin/screen
}
