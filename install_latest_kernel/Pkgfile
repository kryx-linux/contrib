# Description: automate the install of the latest kernels
# URL:         http://www.xs4all.nl/~hanb/software/install_latest_kernel/
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  gnupg

name=install_latest_kernel
version=20060208
release=1
source="http://www.xs4all.nl/~hanb/software/$name/$name-$version.tar.gz"
build()
{
    cd $name-$version
    install -D -m 755 $name $PKG/usr/bin/$name
    install -D -m 755 installkernel $PKG/sbin/installkernel
    install -D -m 644 $name.conf $PKG/etc/$name.conf
    install -D -m 644 lilo.conf.in $PKG/etc/lilo.conf.in
    install -d $PKG/usr/share/$name
    install -m 644 README INSTALL $PKG/usr/share/$name
}
