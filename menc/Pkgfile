name=menc
version=0.5
release=1
source="http://www.noid-project.de/menc/Video-Menc-$version.tar.gz"

build()
{
    cd Video-Menc-$version
    perl Makefile.PL
    make
    make install DESTDIR=$PKG
    find $PKG \
        -name perllocal.pod \
        -o -name "*.bs" \
        -o -name "*LocaleData*" \
        -o -name .packlist | xargs rm -rf
    find $PKG -depth -empty -exec rm -rf {} \;
}
