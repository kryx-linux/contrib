# Description:  scalable, non-blocking webserver
# URL:          http://tornadoweb.org
# Maintainer:   Thomas Penteker, tek at serverop dot de
# Depends on:   python
# Nice to have: python-pycurl, python-simplejson

name=tornadoweb
version=2.2
release=1
source=(http://github.com/downloads/facebook/tornado/tornado-$version.tar.gz)

build () {
   cd tornado-$version
   python setup.py install --root=$PKG
   rm $PKG/usr/lib/python2.7/site-packages/tornado/test/README
}
