name=faac
version=1.31.1
release=1
source=(https://github.com/knik0/faac/archive/$name-$version/$name-$name-$version.tar.gz)

build() {
  cd $name-$name-$version

  ./bootstrap
  ./configure --prefix=/usr

  make
  make DESTDIR=$PKG install
}
