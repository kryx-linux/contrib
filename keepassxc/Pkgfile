# Description: KeePass Cross-Platform Community Edition
# URL: https://keepassxc.org/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: argon2 botan keyutils libgcrypt minizip pcsclite qrencode qt6-tools
# Optional: asciidoctor xorg-libxtst

name=keepassxc
version=2.8.0
release=1
source=(https://github.com/keepassxreboot/keepassxc/releases/download/$version/$name-$version-src.tar.xz)

build() {
  if command -v ccache >/dev/null 2>&1; then
    export PATH=$(echo $PATH | tr ':' '\n' | grep -E '/(s?bin)$' | tr '\n' ':')
  fi

  prt-get isinst ccache && PKGMK_KEEPASSXC+=' -D WITH_CCACHE=ON'

  prt-get isinst asciidoctor && PKGMK_KEEPASSXC+=' -D KPXC_FEATURE_DOCS=ON' || PKGMK_KEEPASSXC+=' -D KPXC_FEATURE_DOCS=OFF'
  prt-get isinst xorg-libxtst || PKGMK_KEEPASSXC+=' -D WITH_X11=OFF'

  cmake -S $name-$version -B build -G Ninja $PKGMK_KEEPASSXC \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_INSTALL_LIBDIR=lib \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
    -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
    -D KEEPASSXC_BUILD_TYPE=Release \
    -D WITH_TESTS=OFF \
    -D WITH_APP_BUNDLE=OFF \
    -D KPXC_FEATURE_UPDATES=OFF \
    -Wno-dev
  cmake --build build
  DESTDIR=$PKG cmake --install build

  rm -r $PKG/usr/share/keepassxc/translations
  rm -rf $PKG/usr/share/keepassxc/docs
}
