# Description:	GNU SASL Library
# URL:		http://www.gnu.org/software/gsasl/
# Maintainer:	Alan Mizrahi, alan at mizrahi dot com dot ve
# Depends on:	

name=libgsasl
version=1.8.0
release=1
source=(ftp://ftp.gnu.org/gnu/gsasl/$name-$version.tar.gz)

build () {
	cd $name-$version
	./configure \
		--prefix=/usr \
		--disable-nls \
		--disable-static
	make
	make DESTDIR=$PKG install
}
