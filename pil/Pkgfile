# Depends on:  python, libjpeg, libpng, freetype

name=pil
version=1.1.5
release=1
source=(http://effbot.org/downloads/Imaging-$version.tar.gz)

build () {
   cd Imaging-$version
   python setup.py build
   python setup.py install --root=$PKG
   chown -R root:root $PKG
}

