name=numeric
version=24.2
release=2
source=(http://dl.sourceforge.net/sourceforge/numpy/Numeric-$version.tar.gz)

build() {
   cd Numeric-$version
   python setup.py install --root=$PKG
   chown -R root:root $PKG
}
