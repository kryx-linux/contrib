# Description: Backported and Experimental Type Hints for Python 3.5+
# URL: https://github.com/python/typing/tree/master/typing_extensions
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-pip
# Optional: python3-flit-core

name=python3-typing_extensions
version=4.3.0
release=1
source=(https://pypi.org/packages/source/t/typing_extensions/typing_extensions-$version.tar.gz)

build() {
  cd typing_extensions-$version

  _pyver=$(/usr/bin/python3 -c 'import sys; print("%s.%s" % sys.version_info[:2])')

  if prt-get isinst python3-flit-core; then
    /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
    /usr/bin/python3 -m installer --compile-bytecode 0 --destdir=$PKG dist/*.whl
  else
    /usr/bin/pip3 install --isolate --root=$PKG --ignore-installed --no-deps typing_extensions
  fi

  rm -rf $PKG/usr/lib/python$_pyver/site-packages/typing_extensions-$version.dist-info/{INSTALLER,REQUESTED}

}
