# Description: Free Japanese TrueType fonts.
# URL:         http://sourceforge.jp/projects/efont/
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:

name=x11-fonts-japanese
version=1.0
release=1
source="
    http://dl.sourceforge.jp/efont/5411/kochi-substitute-20030809.tar.bz2
    http://dl.sourceforge.jp/efont/10087/sazanami-20040629.tar.bz2
"

build()
{
    install -d $PKG/usr/share/fonts/ttf/japanese
    install -m 644 */*.ttf $PKG/usr/share/fonts/ttf/japanese
    cd $PKG/usr/share/fonts/ttf/japanese
    mkfontscale
    mkfontdir
    fc-cache . || touch fonts.cache-1
    cat << EOF > fonts.alias
"Kochi Gothic 8" "Sazanami Gothic 8"
"Kochi Gothic 9" "Sazanami Gothic 9"
"Kochi Gothic 10" "Sazanami Gothic 10"
"Kochi Gothic 11" "Sazanami Gothic 11"
"Kochi Gothic 12" "Sazanami Gothic 12"
"Kochi Gothic 13" "Sazanami Gothic 13"
"Kochi Gothic 14" "Sazanami Gothic 14"
"Kochi Gothic 15" "Sazanami Gothic 15"
"Kochi Gothic 16" "Sazanami Gothic 16"
"Kochi Mincho 8" "Sazanami Mincho 8"
"Kochi Mincho 9" "Sazanami Mincho 9"
"Kochi Mincho 10" "Sazanami Mincho 10"
"Kochi Mincho 11" "Sazanami Mincho 11"
"Kochi Mincho 12" "Sazanami Mincho 12"
"Kochi Mincho 13" "Sazanami Mincho 13"
"Kochi Mincho 14" "Sazanami Mincho 14"
"Kochi Mincho 15" "Sazanami Mincho 15"
"Kochi Mincho 16" "Sazanami Mincho 16"
EOF
}
