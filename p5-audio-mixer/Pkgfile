# Description: Perl extension for Sound Mixer control
# URL:         http://search.cpan.org/~sergey/Audio-Mixer-0.7/Mixer.pm
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  perl

name=p5-audio-mixer
version=0.7
release=1
source="http://www.cpan.org/modules/by-module/Audio/Audio-Mixer-$version.tar.gz"

build()
{
    cd Audio-Mixer-$version
    perl Makefile.PL
    make OPTIMIZE="$CFLAGS"
    make install DESTDIR=$PKG
    # Remove perlcrap
    find $PKG \
	-name .packlist -or \
	-name '*.bs' -or \
	-name autosplit.ix -or \
	-name perllocal.pod | xargs rm
    # Remove empty directories
    find $PKG -depth -empty -exec rm -r "{}" \;
    chmod -R u+w $PKG
}
