# Description: A tool to download rtmp streams.
# URL: http://rtmpdump.mplayerhq.hu/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: gnutls

name=rtmpdump
version=2.6
_commit=6f6bb1353fc84f4cc37138baa99f586750028a01
release=1
source=(https://crux.nu/files/distfiles/rtmpdump-2.6.tar.gz)

build() {
  cd $name-$version

  sed \
    -e '/^CRYPTO=/s/OPENSSL/GNUTLS/' \
    -i Makefile -i librtmp/Makefile

  sed \
    -e 's|OPT=|&-fPIC |' \
    -e 's|OPT|OPTS|' \
    -e 's|CFLAGS=.*|& $(OPT)|' \
    -i librtmp/Makefile

  install -d $PKG/usr/lib

  [ "$CC" ] || CC=gcc

  make \
    CC="$CC" \
    $MAKEFLAGS \
    OPT="$CFLAGS" \
    XLDFLAGS="$LDFLAGS" \
    SYS=posix

  make \
    prefix=/usr \
    sbindir=/usr/bin \
    mandir=/usr/share/man \
    DESTDIR=$PKG \
    install
}
