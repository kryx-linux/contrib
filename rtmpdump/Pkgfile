# Description: A tool to download rtmp streams.
# URL: http://rtmpdump.mplayerhq.hu/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Danny Rawlins, monster dot romster at gmail dot com
# Depends on: zlib openssl

name=rtmpdump
version=2.4
release=1
source=(http://crux.ster.so/distfiles/$name/$name-${version}_p20131018.tar.gz)

build() {
	#sed -i 's/\$(MAKEFLAGS)//g' Makefile

	sed -i \
		-e 's|OPT=|&-fPIC |' \
		-e 's|OPT|OPTS|' \
		-e 's|CFLAGS=.*|& $(OPT)|' \
		librtmp/Makefile


	install -d $PKG/usr/lib

	[ "$CC" ] || CC=gcc

	make \
		CC="$CC" \
		$MAKEFLAGS \
		OPT="$CFLAGS" \
		XLDFLAGS="$LDFLAGS" \
		CRYPTO=OPENSSL \
		SYS=posix

	make \
		CRYPTO=OPENSSL \
		prefix=/usr \
		sbindir=/usr/bin \
		mandir=/usr/man \
		DESTDIR=$PKG \
		install
}
