# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Description: fbset - utility to change the framebuffer-modes
# URL:         http://www.linux-fbdev.org/

name=fbset
version=2.1
release=1
source="
   http://users.telenet.be/geertu/Linux/fbdev/fbset-$version.tar.gz
"
build () {
	cd $name-$version;
	sed -i 's,/dev/fb,/dev/fb/,g' fbset.c
	sed -i 's,/dev/fb,/dev/fb/,g' fbset.8
	make
    install -m 755 -d             $PKG/usr/{bin,man/man{5,8},share/$name}
	install -m 555 fbset          $PKG/usr/bin
	install -m 444 fb.modes.5     $PKG/usr/man/man5
	install -m 444 fbset.8        $PKG/usr/man/man8
    install -m 444 etc/fb.modes.* $PKG/usr/share/$name/
}
