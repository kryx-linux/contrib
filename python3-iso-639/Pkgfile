# Description: Python library for ISO 639 standard.
# URL: https://pypi.python.org/pypi/iso-639/
# Maintainer: Danny Rawlins, crux at romster dot me
# Depends on: python3-setuptools

name=python3-iso-639
version=0.4.5
release=1
source=(https://pypi.python.org/packages/5a/8d/27969852f4e664525c3d070e44b2b719bc195f4d18c311c52e57bb93614e/iso-639-$version.tar.gz)

build() {
	cd ${name#*-}-$version
	/usr/bin/python3 setup.py build
	/usr/bin/python3 setup.py install --root=$PKG --optimize=1
}
