# Description: A very powerful but easy to learn dynamic programming language
# URL: https://www.tcl-lang.org/
# Maintainer: Matt Housh, jaeger at crux dot ninja

name=tcl
version=9.0.1
release=1
source=(https://downloads.sourceforge.net/sourceforge/tcl/$name$version-src.tar.gz)

build() {
    # don't really care about sqlite3 support now, can add later if needed
    rm -r $name$version/pkgs/sqlite*

    cd $name$version/unix
    ./configure --prefix=/usr \
        --enable-64bit
    make
    make INSTALL_ROOT=$PKG install install-private-headers

    install -D -m0644 $SRC/$name$version/library/init.tcl \
        $PKG/usr/lib/tcl${version%.*}/init.tcl

    ln -s tclsh${version%.*} $PKG/usr/bin/tclsh
    ln -s libtcl${version%.*} $PKG/usr/lib/libtcl.so

    chmod 644 $PKG/usr/lib/libtclstub.a

    # cleanup work dir references
    sed -i -e "s,$SRC/$name$version/unix,/usr/lib,g" \
        -e "s,$SRC/$name$version,/usr/include,g" \
        $PKG/usr/lib/tclConfig.sh

    tdbcdir=tdbc1.1.10
    sed -i -e "s,$SRC/$name$version/unix/pkgs/$tdbcdir,/usr/lib/$tdbcdir,g" \
        -e "s,$SRC/$name$version/pkgs/$tdbcdir/generic,/usr/include,g" \
        -e "s,$SRC/$name$version/pkgs/$tdbcdir/library,/usr/lib/tcl${version%.*},g" \
        -e "s,$SRC/$name$version/pkgs/$tdbcdir,/usr/include,g" \
        $PKG/usr/lib/$tdbcdir/tdbcConfig.sh

    itcldir=itcl4.3.2
    sed -i -e "s,$SRC/$name$version/unix/pkgs/$itcldir,/usr/lib/$itcldir,g" \
        -e "s,$SRC/$name$version/pkgs/$itcldir/generic,/usr/include,g" \
        -e "s,$SRC/$name$version/pkgs/$itcldir,/usr/include,g" \
        $PKG/usr/lib/$itcldir/itclConfig.sh
}

