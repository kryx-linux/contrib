# Description: FFmpeg-based plug-ins for gstreamer.
# URL: http://gstreamer.freedesktop.org/modules/gst-ffmpeg.html
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Matt Housh, jaeger at morpheus dot net
# Depends on: gst-plugins-base yasm

name=gst-ffmpeg
version=0.10.6
release=2
source=(http://gstreamer.freedesktop.org/src/$name/$name-$version.tar.gz)

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--disable-static \
		--disable-debug
		
	make
	make DESTDIR=$PKG install
}
