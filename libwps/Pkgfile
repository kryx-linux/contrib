# Description: a Microsoft Works file word processor format import filter library
# URL: https://sourceforge.net/projects/libwps/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: librevenge

name=libwps
version=0.4.13
release=2
source=(https://downloads.sourceforge.net/project/libwps/$name/$name-$version/$name-$version.tar.xz
  libtool.patch.0
  libwps-bundled-soname.patch.0
  rpath.patch.0)

build() {
  cd $name-$version

  patch -Np0 -i $SRC/libtool.patch.0
  patch -Np0 -i $SRC/libwps-bundled-soname.patch.0
  patch -Np0 -i $SRC/rpath.patch.0

  ./configure --prefix=/usr \
    --without-docs
  make
  make DESTDIR=$PKG install
}
