# Description: email index and search tool
# URL: http://www.rc0.org.uk/mairix/
# Maintainer: Simon Gloﬂner, viper at hometux dot de
# Depends on: zlib

name=mairix
version=0.19
release=1
source=(http://www.rpcurnow.force9.co.uk/mairix/$name-$version.tar.gz)

build() {
    cd $name-$version

    ./configure --prefix=/usr
    make
    make DESTDIR=$PKG install

    chmod 755 $PKG/usr/bin/mairix
    chmod 644 $PKG/usr/man/man?/*
}
