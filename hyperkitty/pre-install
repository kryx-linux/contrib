#!/bin/sh -e

_USER=hyperkitty
_HOME=/var/lib/hyperkitty
_GROUP=hyperkitty

/usr/bin/getent group $_GROUP > /dev/null 2>&1 || /usr/sbin/groupadd $_GROUP
/usr/bin/getent passwd $_USER > /dev/null 2>&1 || /usr/sbin/useradd -c 'hyperkitty system user' -g $_GROUP -d $_HOME -s /bin/false $_USER
passwd -l $_USER > /dev/null
