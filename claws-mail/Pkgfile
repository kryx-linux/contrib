# Description: An e-mail client (and news reader), based on GTK+ 
# URL: http://www.claws-mail.org/index.php
# Maintainer: Mikhail Kolesnik, mike at openbunker dot org
# Packager: Brett Goulder, predatorfreak at dcaf-security dot org
# Depends on: gtk libetpan

# Nice to have: openssl gpgme aspell clamav dillo libgnomeprintui openldap 

name=claws-mail
version=3.2.0
release=1
source=(http://dl.sourceforge.net/sylpheed-claws/$name-$version.tar.bz2)

build() {
	cd $name-$version
	./configure --prefix=/usr \
				--disable-nls \
				--disable-manual \
				--mandir=/usr/man
	make
	make DESTDIR=$PKG install
	rm -rf $PKG/usr/share/doc
}
