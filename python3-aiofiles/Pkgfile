# Description:  File support for asyncio
# URL: https://github.com/Tinche/aiofiles
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-lockfile python3-pyproject2setuppy python3-tox

name=python3-aiofiles
version=0.8.0
release=1
source=(https://github.com/Tinche/aiofiles/archive/v$version/$name-$version.tar.gz)

build() {
  cd aiofiles-$version
  /usr/bin/python3 -m pyproject2setuppy.main build
  /usr/bin/python3 -m pyproject2setuppy.main install --prefix=/usr \
    --root=$PKG \
    --skip-build
}
