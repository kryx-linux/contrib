name=remind
version=03.01.04
release=1
source=(http://www.roaringpenguin.com/files/download/$name-$version.tar.gz)

build() {
	cd $name-$version
	./configure --prefix=/usr --mandir=/usr/man
	make
	make DESTDIR=$PKG install
	chown -R root:root $PKG
}
