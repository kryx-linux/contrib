# Description: Python binding to the Networking and Cryptography (NaCl) library
# URL: https://pypi.org/project/PyNaCl/
# Maintainer: Matt Housh, jaeger at crux dot ninja
# Depends on: python3-wheel python3-cffi

name=python3-pynacl
version=1.6.0
release=1
source=(https://files.pythonhosted.org/packages/06/c6/a3124dee667a423f2c637cfd262a54d67d8ccf3e160f3c50f622a85b7723/pynacl-$version.tar.gz)

build() {
    cd pynacl-$version
    /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
    /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
