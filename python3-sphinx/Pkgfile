# Description: The Sphinx documentaion generator
# URL: https://www.sphinx-doc.org/en/master/
# Maintainer: Danny Rawlins, crux at romster dot me
# Depends on: python3-alabaster python3-docutils python3-imagesize python3-jinja python3-packaging python3-pygments python3-requests python3-snowballstemmer python3-sphinxcontrib-applehelp python3-sphinxcontrib-devhelp python3-sphinxcontrib-htmlhelp python3-sphinxcontrib-jsmath python3-sphinxcontrib-qthelp python3-sphinxcontrib-serializinghtml python3-sphinxcontrib-websupport

name=python3-sphinx
_name=Sphinx
version=4.2.0
release=1
source=(https://pypi.org/packages/source/${_name:0:1}/$_name/$_name-$version.tar.gz)

# fails for bsdtar
unpack_source() {
	for file in ${source[@]}; do
		case ${file##*/} in
			$_name-$version.tar.gz)
				tar xfvz $(get_filename $file) -C $SRC ;;
			*)
				cp $(get_filename $file) $SRC ;;
		esac
	done
}

build() {
	cd $_name-$version

	sed -i -e '/^tag_build = .*/d' -e 's,^\(tag_date =\).*$,\1 false,' setup.cfg

	/usr/bin/python3 setup.py build
	/usr/bin/python3 setup.py install --prefix=/usr --root=$PKG --optimize=1 --skip-build

	# fix permissions
	chmod -R go-w $PKG/*
}
