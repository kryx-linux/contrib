# Description: The Sphinx documentaion generator
# URL: https://www.sphinx-doc.org/en/master/
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Depends on: python3-alabaster python3-docutils python3-imagesize python3-jinja2 python3-pygments python3-requests python3-roman-numerals-py python3-snowballstemmer python3-sphinxcontrib-applehelp python3-sphinxcontrib-devhelp python3-sphinxcontrib-htmlhelp python3-sphinxcontrib-jsmath python3-sphinxcontrib-qthelp python3-sphinxcontrib-websupport

name=python3-sphinx
version=8.2.3
release=1
source=(https://pypi.org/packages/source/s/sphinx/sphinx-$version.tar.gz)

build() {
  cd sphinx-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
