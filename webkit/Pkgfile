# Description: Small, efficient and fast rendering engine for Web Browsers.
# URL: http://www.webkitgtk.org/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Brett Goulder, predatorfreak at dcaf-security dot org
# Depends on: enchant gst-plugins-base gtk icu libsoup xorg-libxdamage xorg-libxt

name=webkit
version=1.4.2
release=1
source=(http://webkitgtk.org/$name-$version.tar.gz)

build() {
	cd $name-$version

	# Don't force to -O2 but use CXXFLAGS
	sed -i -e 's/-O2//g' configure

	./configure \
		--prefix=/usr \
		--enable-video \
		--with-font-backend=freetype \
		--disable-gtk-doc \
		--enable-jit \
		--with-unicode-backend=icu

	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share/locale
}
