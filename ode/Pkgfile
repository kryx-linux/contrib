name=ode
version=0.9
release=1
source=(http://dl.sourceforge.net/sourceforge/opende/$name-src-$version.zip)

build() {
  cd $name-$version
  ./configure --prefix=/usr \
              --disable-static \
              --disable-debug
  make
  make DESTDIR=$PKG install
}
