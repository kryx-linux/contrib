name=ode
version=0.8
release=1
source=(http://dl.sourceforge.net/sourceforge/opende/ode-src-$version.zip)

build() {
	cd $name-$version

	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install

	chown -R root:root $PKG
}
