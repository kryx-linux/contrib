# Depends on:	python

name=mako
version=0.1.5
release=1
source=(http://www.makotemplates.org/downloads/Mako-$version.tar.gz)

build() {
	cd Mako-$version
	python setup.py install --root=$PKG
	chown -R root:root $PKG
}
