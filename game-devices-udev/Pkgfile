# Description: udev rules for game devices
# URL: https://codeberg.org/fabiscafe/game-devices-udev
# Maintainer: Matt Housh, jaeger at crux dot ninja

name=game-devices-udev
version=1.0
release=1
source=(https://codeberg.org/fabiscafe/game-devices-udev/archive/$version.tar.gz 70-uinput.rules)
renames=($name-$version.tar.gz)

build() {
    meson setup $name build \
        --prefix=/
    DESTDIR=$PKG meson install -C build
    sed -i -e 's:\( MODE="0660",\):\1 GROUP="input",:g' $PKG/lib/udev/rules.d/*.rules
    install -m 0644 $SRC/*.rules $PKG/lib/udev/rules.d/
}

