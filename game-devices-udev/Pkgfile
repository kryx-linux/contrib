# Description: udev rules for game devices
# URL: https://codeberg.org/fabiscafe/game-devices-udev
# Maintainer: Matt Housh, jaeger at crux dot ninja

name=game-devices-udev
version=0.25
release=1
source=(https://codeberg.org/fabiscafe/game-devices-udev/archive/$version.tar.gz)
renames=($name-$version.tar.gz)

build() {
	install -d -m 0755 $PKG/etc/udev/rules.d
	install -m 0644 $name/*.rules $PKG/etc/udev/rules.d/
	sed -i -e 's:\( MODE="0660",\):\1 GROUP="input",:g' $PKG/etc/udev/rules.d/*.rules
}
