# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  perl

name=p5-mime-tools
capsname=MIME-tools
version=5.420
release=1
source="http://www.cpan.org/modules/by-module/MIME/$capsname-$version.tar.gz"

build() {
  cd $capsname-$version
  perl Makefile.PL
  make OPTIMIZE="$CFLAGS"
  make install DESTDIR=$PKG
  # Remove perlcrap
  find $PKG \
      -name .packlist -or \
      -name '*.bs' -or \
      -name perllocal.pod | xargs rm
  # Remove empty directories
  find $PKG -depth -empty -exec rm -rf {} \;
}
