# Description: Small, efficient and fast rendering engine for Web Browsers.
# URL: http://www.webkitgtk.org/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Brett Goulder, predatorfreak at dcaf-security dot org
# Depends on: enchant gst-plugins-base1 gtk harfbuzz-icu libsoup glu ruby gperf libwebp libsecret

name=webkit-gtk2
version=2.4.3
release=1
source=(http://webkitgtk.org/releases/webkitgtk-$version.tar.xz)

build() {
	cd webkitgtk-$version

	install -d build
	cd build

	../configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--disable-geolocation \
		--disable-gtk-doc-html \
		--disable-silent-rules \
		--enable-video \
		--enable-jit \
		--libexecdir=/usr/lib/webkitgtk2 \
		--with-gtk=2.0 \
		--disable-webkit2

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/share/locale
}
