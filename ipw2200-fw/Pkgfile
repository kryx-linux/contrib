name=ipw2200-fw
version=3.1
release=1
source=(http://bughost.org/firmware/$name-$version.tgz)

build() {
  install -d $PKG/lib/firmware
  find $name-$version -name "LICENSE.ipw2200-fw" -delete
  cp $name-$version/* $PKG/lib/firmware
}
