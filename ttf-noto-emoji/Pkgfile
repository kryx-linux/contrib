# Description: Noto emoji font
# URL: https://www.google.com/get/noto/
# Maintainer: Tim Biermann, tbier at posteo dot de

name=ttf-noto-emoji
version=2026-09-24
release=1
source=(https://github.com/googlefonts/noto-emoji/archive/v${version}-unicode18_0/noto-emoji-$version.tar.gz)

build() {
  mkdir -p $PKG/usr/share/fonts/noto
  for i in noto-emoji-${version}-unicode18_0/2D/fonts/*.ttf noto-emoji-${version}-unicode18_0/3D/fonts/*.ttf; do
    install -m644 $i $PKG/usr/share/fonts/noto
  done
}
