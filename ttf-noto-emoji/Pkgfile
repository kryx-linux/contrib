# Description: Noto emoji font
# URL: https://www.google.com/get/noto/
# Maintainer: Tim Biermann, tbier at posteo dot de

name=ttf-noto-emoji
version=2.051
release=2
source=(https://github.com/googlefonts/noto-emoji/archive/v$version/noto-emoji-$version.tar.gz)

build() {
  mkdir -p $PKG/usr/share/fonts/noto
  for i in noto-emoji-$version/fonts/*.ttf; do
    install -m644 $i $PKG/usr/share/fonts/noto
  done
}
