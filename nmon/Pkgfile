name=nmon
version=12f
release=1
source=(http://dl.sourceforge.net/nmon/lmon${version}.c)

build() {
  install -d -m 755 $PKG/usr/bin
  cc -lncurses -DJFS -DLARGEMEM -o $PKG/usr/bin/nmon lmon${version}.c
}
