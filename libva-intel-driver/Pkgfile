# Description: libva video acceleration for newer intel based setups
# URL: https://github.com/intel/intel-vaapi-driver
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on:  ffmpeg glu libva

name=libva-intel-driver
version=2.4.4
release=1
source=(https://github.com/irql-notlessorequal/intel-vaapi-driver/archive/$version/$name-$version.tar.gz)

build() {
  meson intel-vaapi-driver-$version build \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true
  ninja -C build
  DESTDIR=$PKG ninja -C build install
}
