name=xa
version=2.4.1
release=1
source=(https://www.floodgap.com/retrotech/xa/dists/$name-$version.tar.gz)

build() {
  cd $name-$version
  make
  sed -i -e 's,^install:.*,install: xa uncpk,g' Makefile
  make DESTDIR=$PKG install
}
