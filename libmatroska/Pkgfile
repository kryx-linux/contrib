name=libmatroska
version=1.1.0
release=1
source=(http://www.bunkus.org/videotools/mkvtoolnix/sources/$name-$version.tar.bz2)

build() {
	cd $name-$version/make/linux
	make
	make -e prefix=$PKG/usr install
}
