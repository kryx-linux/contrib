# Description: Provides powerful extensions to the standard datetime module
# URL: https://github.com/dateutil/dateutil
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-setuptools-scm python3-six

name=python3-dateutil
version=3.0.0
release=1
source=(https://pypi.org/packages/source/p/python_dateutil/python_dateutil-$version.tar.gz)

build() {
  cd python_dateutil-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
