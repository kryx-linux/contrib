# Description: A few DR17 modules.
# URL:         http://www.enlightenment.org/
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  e17

name=e_modules
version=cvs
release=1

build()
{
    cd $PKGMK_SOURCE_DIR/e17
    if cd $name ; then
	cvs -z3 -q up -dAP
    else
	cvs -z3 -q -d :pserver:anonymous@anoncvs.enlightenment.org:/var/cvs/e co $name
    fi

    cd $SRC
    lndir $PKGMK_SOURCE_DIR/e17/$name

    ./autogen.sh --prefix=/usr
    for dir in $(find -type d -maxdepth 1); do
	(
	    cd $dir
	    make && make install DESTDIR=$PKG || :
	)
    done
    rm -R $PKG/usr/share/
}
