# Description: gtk library for writing file managers
# URL:         http://pcmanfm.sourceforge.net/
# Maintainer:  Bartlomiej Palmowski, rotwang at crux dot org dot pl
# Depends on:  gtk menu-cache

name=libfm
version=0.1.17
release=2
source=("http://ftp.jaist.ac.jp/pub/sourceforge/p/project/pc/pcmanfm/PCManFM%20+%20Libfm%20(tarball%20release)/libfm%20(required%20by%20PCManFM)/$name-$version.tar.gz")

build() {
    cd $name-$version
    ./configure \
        --prefix=/usr \
        --disable-nls \
        --disable-static \
        --sysconfdir=/etc \
        --disable-gtk-doc-html
    make
    make DESTDIR=$PKG install
    rm -rf $PKG/usr/share/locale
    rm -rf $PKG/usr/share/gtk-doc
}

