# Description: gtk library for writing file managers
# URL:         http://pcmanfm.sourceforge.net/
# Maintainer:  Bartlomiej Palmowski, rotwang at crux dot org dot pl
# Depends on:  gtk menu-cache intltool xorg-libxdamage

name=libfm
version=1.1.0
release=1
source=("http://downloads.sourceforge.net/project/pcmanfm/PCManFM%20%2B%20Libfm%20(tarball%20release)/libfm%20(required%20by%20PCManFM)/libfm-1.1.0.tar.gz")

build() {
    cd $name-$version
    ./configure \
        --prefix=/usr \
        --disable-nls \
        --disable-static \
        --sysconfdir=/etc \
        --disable-gtk-doc-html
    make
    make DESTDIR=$PKG install
    rm -rf $PKG/usr/share/locale
    rm -rf $PKG/usr/share/gtk-doc
    if [[ -h $PKG/usr/include/libfm/libfm-1.0 ]]; then
        rm $PKG/usr/include/libfm/libfm-1.0
        cd $PKG/usr/include/
        ln -s libfm-1.0 libfm
    fi
}

