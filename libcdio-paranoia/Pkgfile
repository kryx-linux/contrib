# Description: CD paranoia libraries from libcdio
# URL: https://github.com/libcdio/libcdio-paranoia
# Maintainer: John McQuah, jmcquah at disroot dot org
# Depends on: libcdio

name=libcdio-paranoia
version=10.2+2.0.2
release=1
source=(https://github.com/libcdio/$name/releases/download/release-$version/$name-$version.tar.bz2)

build() {
    cd $name-$version

    ./configure \
        --prefix=/usr \
        --disable-example-progs
        
    make
    make DESTDIR=$PKG install

    rm -r $PKG/usr/share/man/ja
    rm $PKG/usr/lib/*.la
}
