name=nodejs
_name=node
version=0.10.33
release=2
source=(http://nodejs.org/dist/v${version}/$_name-v${version}.tar.gz)

build() {
    cd $_name-v${version}

    ./configure --prefix=/usr
    make
    make DESTDIR=$PKG install

    chown -R root:root $PKG
}
