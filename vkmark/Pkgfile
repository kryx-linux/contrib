# Description: vkmark is an extensible Vulkan benchmarking suite with targeted, configurable scenes
# URL: https://github.com/vkmark/vkmark
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: assimp glm vulkan-loader wayland-protocols
# Optional: xorg-xcb-util-wm

name=vkmark
version=2025.01
release=2
source=(https://github.com/vkmark/vkmark/archive/$version/$name-$version.tar.gz
  79.patch
  81.patch)

build() {
  patch -Np1 -d $name-$version -i $SRC/79.patch
  patch -Np1 -d $name-$version -i $SRC/81.patch

  meson setup $name-$version build \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true
  meson compile -C build
  DESTDIR=$PKG meson install -C build
}
