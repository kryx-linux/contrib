# Description: Shanes Chess Information Database
# URL:         http://scid.sf.net
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  tk

name=scid
version=3.6.1
release=1
source="
    http://dl.sourceforge.net/sourceforge/$name/$name-$version.tar.gz
    http://dl.sourceforge.net/scid/scidlet40k.zip
"

build()
{
    cd $name-$version
    ./configure \
        OPTIMIZE="$CXXFLAGS" \
        BINDIR=/usr/bin \
        SHAREDIR=/usr/share/$name
    make
    make install DESTDIR=$PKG
    install $SRC/scidlet40k.sbk $PKG/usr/share/$name/$name.sbk
    install scid.rc $PKG/usr/share/$name/${name}rc
}
