# Description: Complete solution to record, convert and stream audio and video.
# URL: http://ffmpeg.org/
# Maintainer: Danny Rawlins, crux at romster dot me
# Packager: Danny Rawlins, crux at romster dot me
# Depends on: libass libsdl2 libva yasm

name=ffmpeg-compat
version=2.8.8
release=1
source=(http://ffmpeg.org/releases/ffmpeg-$version.tar.bz2)

build() {
	cd ffmpeg-$version

	./configure \
		--prefix=/usr \
		--incdir='/usr/include/ffmpegs-compat' \
		--libdir='/usr/lib/ffmpeg-compat' \
		--shlibdir='/usr/lib/ffmpeg-compat' \
		--disable-debug \
		--disable-doc \
		--enable-gpl \
		--enable-version3 \
		--enable-shared \
		--enable-pic \
		--enable-avfilter \
		--enable-avresample \
		--enable-postproc \
		--enable-pthreads \
		--enable-swresample \
		--enable-libass \
		--enable-vdpau \
		--enable-libfreetype

	make
	make DESTDIR=$PKG install

	install -d $PKG/etc/ld.so.conf.d
	echo -e '/usr/lib/\n/usr/lib/ffmpeg-compat/' > \
		$PKG/etc/ld.so.conf.d/ffmpeg-compat.conf

	rm -r $PKG/usr/{bin,share/ffmpeg}
}
