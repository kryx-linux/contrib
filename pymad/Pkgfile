# Description: pythonwrapper for the MPEG Audio decoder library
# URL:         http://spacepants.org/src/pymad/
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  libmad python

name=pymad
version=0.5.4
release=1
source="http://spacepants.org/src/pymad/download/$name-$version.tar.gz"

build()
{
    cd $name-$version
    python config_unix.py
    python setup.py build
    python setup.py install --root=$PKG
}
