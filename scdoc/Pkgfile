# Description: scdoc is a simple man page generator for POSIX systems written in C99
# URL: https://git.sr.ht/~sircmpwn/scdoc
# Maintainer: Tim Biermann, tbier at posteo dot de

name=scdoc
version=1.11.3
release=1
source=(https://git.sr.ht/~sircmpwn/$name/archive/$version.tar.gz)

build() {
  cd $name-$version
  CC="gcc" make PREFIX=/usr
  DESTDIR=$PKG make PREFIX=/usr install
}
