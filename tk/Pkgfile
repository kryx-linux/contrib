# Description: A graphical user interface toolkit that takes developing desktop applications to a higher level than conventional approaches
# URL: https://www.tcl-lang.org/
# Maintainer: Matt Housh, jaeger at crux dot ninja
# Depends on: tcl zip xorg-libx11

name=tk
version=9.0.4
release=1
source=(https://downloads.sourceforge.net/sourceforge/tcl/$name$version-src.tar.gz)

build() {
    cd $name$version/unix
    ./configure --prefix=/usr \
        --enable-64bit
    make
    make INSTALL_ROOT=$PKG install install-private-headers

    ln -s wish${version%.*} $PKG/usr/bin/wish
    ln -s libtcl9tk${version%.*}.so $PKG/usr/lib/libtk.so
    ln -s libtcl9tk${version%.*}.so $PKG/usr/lib/libtk${version%.*}.so

    chmod 644 $PKG/usr/lib/libtkstub.a

    # cleanup work dir references
    sed -i -e "s,$SRC/$name$version/unix,/usr/lib,g" \
        -e "s,$SRC/$name$version,/usr/include,g" \
        $PKG/usr/lib/tkConfig.sh
}

