# Description: Cleo allows you to create beautiful and testable command-line interfaces.
# URL: https://github.com/sdispater/cleo
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-clikit

name=python3-cleo
version=0.8.1
release=1
source=(https://github.com/sdispater/cleo/archive/$version/$name-$version.tar.gz)

build() {
  cd cleo-$version

  if prt-get isinst python3-poetry; then
    /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
    /usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
  else
    /usr/bin/pip3 install --isolate --root=$PKG --ignore-installed --no-deps cleo
  fi
}
