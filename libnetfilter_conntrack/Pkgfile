# Description: Library providing a API to the in-kernel connection tracking state table.
# URL: http://www.netfilter.org/projects/libnetfilter_conntrack
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Jurgen Daubert, juergen dot daubert at t-online dot de
# Depends on: libnfnetlink

name=libnetfilter_conntrack
version=1.0.2
release=1
source=(http://www.netfilter.org/projects/$name/files/$name-$version.tar.bz2)

build() {
	cd $name-$version
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
