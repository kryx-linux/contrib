name=unibilium
version=2.1.1
release=1
source=(https://github.com/neovim/unibilium/archive/v$version/$name-$version.tar.gz)

build() {
  cd $name-$version
  make PREFIX=/usr
  DESTDIR=$PKG make install PREFIX=/usr
}
