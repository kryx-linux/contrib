name=iasl
version=20090903
release=1
source=(http://www.acpica.org/download/acpica-unix-$version.tar.gz)

build() {
  cd acpica-unix-$version/compiler
  make -j1 aslcompilerlex.c
  sed 's/\#undef\ yytext_ptr//' -i aslcompilerlex.c
  make -j1
  install -D -m 0755 $name $PKG/usr/bin/$name
}
