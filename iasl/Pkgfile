name=iasl
version=20130214
release=1
source=(http://www.acpica.org/download/acpica-unix-$version.tar.gz)

build() {
  cd acpica-unix-$version

  make clean
  make BITS=64 HOST=_LINUX

  install -D -m 0755 generate/unix/bin64/$name $PKG/usr/bin/$name
}
