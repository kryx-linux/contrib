# Description: API for packets queued by the kernel packet filter.
# URL: http://www.netfilter.org/projects/libnetfilter_queue/index.html
# Maintainer: Danny Rawlins, crux at romster dot me
# Packager: Nathan Pardoe, lithium at poolofrandomness dot com
# Depends on: libnfnetlink libmnl

name=libnetfilter_queue
version=1.0.2
release=1
source=(http://www.netfilter.org/projects/$name/files/$name-$version.tar.bz2)

build() {
    cd $name-$version

    ./configure \
	 	--prefix=/usr \
		--disable-static

    make
    make DESTDIR=$PKG install
}
