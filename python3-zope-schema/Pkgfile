# Description: zope.interface extension for defining data schemas
# URL: https://github.com/zopefoundation/zope.schema
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-zope-event python3-zope-interface

name=python3-zope-schema
version=8.1
release=1
source=(https://pypi.org/packages/source/z/zope_schema/zope_schema-$version.tar.gz)

build() {
  cd zope_schema-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
