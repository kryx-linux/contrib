# Depends on: setuptools

name=django
version=r8740
release=1
source=(http://crux.nu/~lucas/files/$name-$version.tar.bz2)

build() {
	cd $name-$version
	python setup.py install --root=$PKG
	# Don't lay eggs
	find $PKG -name '*egg-info' | xargs rm
}
