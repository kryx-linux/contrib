# Depends on: setuptools

name=django
version=1.0
release=1
source=(http://media.djangoproject.com/releases/$version/Django-$version.tar.gz)

build() {
	cd Django-$version
	python setup.py install --root=$PKG
	# Don't lay eggs
	find $PKG -name '*egg-info' | xargs rm
}
