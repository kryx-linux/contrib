# Description: Noto emoji font
# URL: https://www.google.com/get/noto/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on:

name=noto-emoji
version=2020-07-22-unicode13_0
release=1
source=(https://github.com/googlefonts/noto-emoji/archive/v$version/$name-$version.tar.gz)

build() {
  mkdir -p $PKG/usr/share/fonts/noto
  install -m644 $name-$version/fonts/NotoColorEmoji.ttf $PKG/usr/share/fonts/noto
}
