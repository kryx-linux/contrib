# Description: transmit and receive binary files via usenet
# URL:         http://www.fpx.de/fp/Software/UUDeview/
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  
# Nice to have: tk

name=uudeview
version=0.5.20
release=1
source="http://www.fpx.de/fp/Software/UUDeview/download/uudeview-$version.tar.gz"

build()
{
    cd $name-$version
    ./configure \
        --prefix=/usr \
        --disable-nls
    make
    make install prefix=$PKG/usr
    cd uulib
    ./configure \
        --prefix=/usr \
        --disable-nls
    make
    install -d  $PKG/usr/{lib,include}/uulib/
    install *.a $PKG/usr/lib/uulib/
    install *.h $PKG/usr/include/uulib
}
