# Description: gpgme bindings for python.
# URL: http://www.gnupg.org/gpgme.html
# Maintainer: Danny Rawlins, crux at romster dot me
# Packager: Danny Rawlins, crux at romster dot me
# Depends on: gpgme swig python

name=gpgme-python
version=1.8.0
release=1
source=(https://www.gnupg.org/ftp/gcrypt/gpgme/gpgme-$version.tar.bz2
	gpgme-1.1.8-et_EE.patch
	gpgme-1.8.0-cmake.patch)

build() {
	cd gpgme-$version

	patch -p1 -i $SRC/gpgme-1.1.8-et_EE.patch
	patch -p1 -i $SRC/gpgme-1.8.0-cmake.patch

	./configure \
		--prefix=/usr \
		--enable-languages='python2'

	make
	make DESTDIR=$PKG install

	install -d $PKG/usr/etc/gpgme
	echo python > $PKG/usr/etc/gpgme/python

	rm \
		$PKG/usr/bin/{gpgme-config,gpgme-tool} \
		$PKG/usr/include/gpgme.h \
		$PKG/usr/lib/libgpgme.* \
		$PKG/usr/share/aclocal/gpgme.m4

	rm -r $PKG/usr/share/info
}
