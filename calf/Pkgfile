# Description: LV2/DSSI/LADSPA plug-in suite and standalone Jack host
# URL: https://calf-studio-gear.org
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: fluidsynth lv2
# Optional: fftw gtk jack pulseaudio

name=calf
version=0.90.6
release=1
source=(https://github.com/calf-studio-gear/calf/archive/$version/$name-$version.tar.gz)

build() {
  cmake -S $name-$version -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_INSTALL_LIBDIR=lib \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
    -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
    -Wno-dev
  cmake --build build
  DESTDIR=$PKG cmake --install build
}
