# Description: Ministream is a small subset of libappstream
# URL: https://gitlab.gnome.org/GNOME/ministream
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: glib
# Optional: glib-introspection

name=ministream
version=0.99.1
release=1
source=(https://gitlab.gnome.org/GNOME/ministream/-/archive/$version/ministream-$version.tar.bz2)

build() {
  prt-get isinst glib-introspection || PKGMK_MINISTREAM+=' -D introspection=disabled'

  meson setup $name-$version build $PKGMK_MINISTREAM \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true \
    -D as-compare=disabled \
    -D tests=false
  meson compile -C build
  DESTDIR=$PKG meson install -C build
}
