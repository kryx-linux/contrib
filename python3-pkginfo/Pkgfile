# Description: Query metadatdata from sdists / bdists / installed packages
# URL: https://pypi.python.org/pypi/pkginfo
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-wheel

name=python3-pkginfo
version=2.0
release=1
source=(https://pypi.io/packages/source/p/pkginfo/pkginfo-$version.tar.gz)

build() {
  cd pkginfo-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl

  mv $PKG/usr/bin/{,py3-}pkginfo
}
