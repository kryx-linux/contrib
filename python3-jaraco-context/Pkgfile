# Description: Useful decorators and context managers
# URL: https://github.com/jaraco/jaraco.context
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-backports-tarfile

name=python3-jaraco-context
version=6.1.1
release=1
source=(https://pypi.org/packages/source/j/jaraco_context/jaraco_context-$version.tar.gz)

build() {
  cd jaraco_context-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
