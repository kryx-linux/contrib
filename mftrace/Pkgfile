# Description: Scalable Fonts for MetaFont
# URL:         http://www.xs4all.nl/~hanwen/mftrace/
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  fontforge python t1utils tetex

name=mftrace
version=1.2.5
release=1
source="http://www.xs4all.nl/~hanwen/mftrace/mftrace-$version.tar.gz"

build() {
    cd $name-$version
    ./configure \
        --prefix=/usr \
        --disable-nls
    make
    make install DESTDIR=$PKG
}
