# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# URL:         http://freedesktop.org/Software/xapps
# Description: Sample X Compositing Manager straight from CVS
# Depends:     xorg

name=xcompmgr
version=7.1
release=1
source=

build()
{
    local SERVER=:pserver:anoncvs@cvs.freedesktop.org:/cvs/xapps

    cd $PKGMK_SOURCE_DIR
    cvs -d $SERVER co xcompmgr
    cp -r $PKGMK_SOURCE_DIR/xcompmgr $SRC
    cd $SRC/xcompmgr
    # Of course you can run ./autogen.sh && ./configure && make all install
    # But this is what happens in effecto.
    gcc -Wall \
	-DXTHREADS -D_REENTRANT -DXUSE_MTSAFE_API \
	-I/usr/include/X11 -L/usr/lib/X11 \
	-lXcomposite -lXdamage -lXfixes -lXrender -lX11 -lXext -lm \
	xcompmgr.c -o xcompmgr
    install -D $name   $PKG/usr/bin/$name
    install -D $name.1 $PKG/usr/man/man1/$name.1
}
