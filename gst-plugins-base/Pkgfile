# Description: An essential exemplary set of plugins for gstreamer.
# URL: http://gstreamer.freedesktop.org/modules/gst-plugins-base.html
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Matt Housh, jaeger at morpheus dot net
# Depends on: alsa-lib cdparanoia e2fsprogs glibc gstreamer liboil libtheora libvisual pango xorg-libxv

name=gst-plugins-base
version=0.10.22
release=1
source=(http://gstreamer.freedesktop.org/src/$name/$name-$version.tar.bz2)

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--disable-static \
		--disable-debug \
		--disable-nls \
		--disable-dependency-tracking \
		--disable-valgrind \
		--disable-examples

	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share/gtk-doc
}
