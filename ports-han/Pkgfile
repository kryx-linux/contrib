# Packager:    Per Lidén <per@fukt.bth.se>
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Description: basic scripts for portstree maintainance
# URL:         http://crux.nu

name=ports
version=1.5
release=7
source="
    http://www.fukt.bth.se/~per/crux/files/ports/$name-$version.tar.gz
    ports
    core.rsync
    opt.rsync
"

build ()
{
    cd $name-$version
    make
    make install DESTDIR=$PKG
    install -m 0755 $SRC/ports      $PKG/usr/bin/ports
    install -m 0644 $SRC/core.rsync $PKG/etc/ports/
    install -m 0644 $SRC/opt.rsync  $PKG/etc/ports/
}
