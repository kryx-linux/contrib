# Description: An efficient cross platform serialization library for C++, with support for Java, C# and Go
# URL: https://google.github.io/flatbuffers/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: cmake python3-setuptools

name=flatbuffers
version=1.12.0
release=1
source=(#https://github.com/google/flatbuffers/archive/v$version/$name-$version.tar.gz
  https://github.com/google/flatbuffers/archive/a402b3abaea6490d8aad1fe90d8bafe2a6396fe8/$name-$version-1.tar.gz)

build() {
  #cmake -S$name-$version -Bbuild \
  cmake -S$name-a402b3abaea6490d8aad1fe90d8bafe2a6396fe8 -Bbuild \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DFLATBUFFERS_BUILD_FLATLIB=OFF \
    -DFLATBUFFERS_BUILD_SHAREDLIB=ON
  cmake --build build
  DESTDIR=$PKG cmake --install build
}
