name=twisted
version=2.5.0
release=1
source=(http://tmrc.mit.edu/mirror/twisted/Twisted/${version::3}/Twisted-$version.tar.bz2)

build() {
	cd Twisted-$version

	python setup.py build
	python setup.py install --home=$PKG/usr

	rm $PKG/usr/lib/python/twisted/python/zsh/README
}

