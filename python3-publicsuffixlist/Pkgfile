name=python3-publicsuffixlist
version=1.0.2.20260108
release=1
source=(https://pypi.org/packages/source/p/publicsuffixlist/publicsuffixlist-$version.tar.gz)

build() {
  cd publicsuffixlist-$version

  /usr/bin/python3 setup.py build
  /usr/bin/python3 setup.py install --prefix=/usr \
    --root=$PKG \
    --skip-build
}
