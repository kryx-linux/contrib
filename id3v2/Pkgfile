# Description: id3 tagging util which also supports v1 tags
# URL:         http://id3v2.sf.net
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  id3lib

name=id3v2
version=0.1.11
release=1
source="http://dl.sourceforge.net/sourceforge/$name/$name-$version.tar.gz"

build()
{
    cd $name-$version
    make
    install -d $PKG/usr/{bin,man/man1}
    install -m 755 id3v2   $PKG/usr/bin
    install -m 444 id3v2.1 $PKG/usr/man/man1
}
