# Description: Decoder implementation of JBIG2 image compression format
# URL: https://www.jbig2dec.com/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: openjpeg2

name=jbig2dec
version=0.20
release=1
source=(https://github.com/ArtifexSoftware/jbig2dec/archive/$version/$name-$version.tar.gz)

build() {
  cd $name-$version

  ./autogen.sh \
    --prefix=/usr \
    --with-libpng=/usr/lib

  make
  make DESTDIR=$PKG install

  install -m 644 memento.h $PKG/usr/include
}
