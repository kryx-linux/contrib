# Description: proxy client functionality for Python
# URL: https://github.com/romis2012/python-socks
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-wheel
# Optional: python3-async-timeout python3-trio python3-curio python3-anyio

name=python3-python-socks
version=3.2.2
release=1
source=(https://pypi.org/packages/source/p/python_socks/python_socks-$version.tar.gz)

build() {
  cd python_socks-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
