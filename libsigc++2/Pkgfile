# Description: A callback framework for C++.
# URL: https://libsigcplusplus.github.io/libsigcplusplus/
# Maintainer: John McQuah, jmcquah at disroot dot org

name=libsigc++2
version=2.12.2
release=1
source=(https://github.com/libsigcplusplus/libsigcplusplus/releases/download/$version/libsigc++-$version.tar.xz)

build() {
  meson setup bld libsigc++-$version \
    --prefix=/usr \
    --buildtype=release \
    -D build-documentation=false \
    -D b_lto=true \
    -D b_pie=true

  ninja -C bld -j ${JOBS:-1}
  DESTDIR="$PKG" ninja -C bld install

  find "$PKG" \( -type f -a -perm -g+w \) -exec chmod g-w '{}' +
}
