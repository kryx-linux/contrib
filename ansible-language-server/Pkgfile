# Description: Ansible Language Server
# URL: https://github.com/ansible/vscode-ansible/tree/main/packages/ansible-language-server
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: ansible pnpm yarn
# Optional: ansible-lint yamllint

name=ansible-language-server
version=26.11.0
_repo_version=26.11.0
release=1
source=(https://github.com/ansible/vscode-ansible/archive/v$_repo_version/vscode-ansible-$_repo_version.tar.gz
  als.sh)

build() {
  cd vscode-ansible-$_repo_version

  pnpm install --frozen-lockfile

  cd packages/ansible-language-server
  NODE_ENV=production pnpm run compile

  install -d $PKG/usr/lib/node_modules/$name
  install -d $PKG/usr/bin

  cp $SRC/als.sh $PKG/usr/bin/ansible-language-server
  cp -a dist/. $PKG/usr/lib/node_modules/$name/
}
