name=pycrypto
version=2.0.1
release=5
source=(http://www.amk.ca/files/python/crypto/$name-$version.tar.gz)

build() {
	cd $name-$version
	python setup.py install --root=$PKG
	find $PKG -name '*egg-info' | xargs rm
}
