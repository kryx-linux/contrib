name=pycrypto
version=2.0.1
release=3
source=(http://www.amk.ca/files/python/crypto/$name-$version.tar.gz)

build () {
   cd $name-$version
   python setup.py install --root=$PKG
   rm $PKG/usr/lib/python2.5/site-packages/*.egg-info
}
