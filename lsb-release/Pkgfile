# Description: LSB version query program (wraps around /etc/os-release)
# URL: https://www.linuxbase.org
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: dash

name=lsb-release
version=12.1
release=1
source=(https://salsa.debian.org/gioele/lsb-release-minimal/-/archive/v12.1/lsb-release-minimal-v12.1.tar.gz)

build() {
  cd $name-minimal-v$version

  make
  make DESTDIR=$PKG install
}
