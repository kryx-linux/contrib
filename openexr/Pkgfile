# Description: High dynamic-range (HDR) image file format library.
# URL: http://www.openexr.com/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Jose V Beneyto, sepen at users dot sourceforge dot net
# Depends on: ilmbase

name=openexr
version=1.7.0
release=1
source=(http://download.savannah.nongnu.org/releases/$name/$name-$version.tar.gz	openexr-1.7.0-gcc43.patch)


build() {
	cd $name-$version

	patch -p 0 -i $SRC/openexr-1.7.0-gcc43.patch

	./configure \
		--prefix=/usr \
		--disable-static \
		--disable-dependency-tracking

	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share/doc
}
