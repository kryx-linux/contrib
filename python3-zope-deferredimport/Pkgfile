# Description: Defer imports until used by code.
# URL: https://github.com/zopefoundation/zope.deferredimport
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-zope-proxy

name=python3-zope-deferredimport
version=6.1
release=1
source=(https://pypi.org/packages/source/z/zope_deferredimport/zope_deferredimport-$version.tar.gz)

build() {
  cd zope_deferredimport-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
