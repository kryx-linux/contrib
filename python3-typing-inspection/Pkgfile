# Description: Runtime typing introspection tools
# URL: https://github.com/pydantic/typing-inspection
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-hatchling python3-typing_extensions

name=python3-typing-inspection
version=0.4.1
release=1
source=(https://pypi.org/packages/source/t/typing_inspection/typing_inspection-$version.tar.gz)

build() {
  cd typing_inspection-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
