name=xdg-utils
version=1.0.2
release=1
source=(http://portland.freedesktop.org/download/${name}-${version}.tgz)

build() {
  cd ${name}-${version}
  ./configure --prefix=/usr \
              --mandir=/usr/man \
              --disable-nls
  make
  make DESTDIR=${PKG} install
}
