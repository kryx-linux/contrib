# Description: Typing stubs for python-dateutil
# URL: https://github.com/python/typeshed
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-wheel

name=python3-types-python-dateutil
version=2.9.0.20260508
release=1
source=(https://pypi.org/packages/source/t/types-python-dateutil/types_python_dateutil-$version.tar.gz)

build() {
  cd types_python_dateutil-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
