name=nawk
version=20211208
realn=awk
gitver=99f6a432969cd42aa1dcba580eefe9d23601e51b
release=1
source=(
   https://github.com/onetrueawk/${realn}/archive/\
${gitver}/${realn}-${version}.tar.gz
)

build() {
   cd ${realn}-${gitver}

   make
   install -D a.out "${PKG}"/usr/bin/${name}
   install -D -m 0644 awk.1 "${PKG}"/usr/share/man/man1/${name}.1
}

