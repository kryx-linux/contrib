# Description: Pure python module for (de)serialization to and from VDF that works just like json
# URL: https://github.com/solsticegamestudios/vdf
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-setuptools

name=python3-vdf
version=4.0
release=1
source=(https://github.com/solsticegamestudios/vdf/archive/v$version/vdf-$version.tar.gz)

build() {
  cd vdf-$version

  /usr/bin/python3 setup.py build
  /usr/bin/python3 setup.py install -O2 --root=$PKG --skip-build
}
