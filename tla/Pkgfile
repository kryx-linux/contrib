# Depends on:  neon
# Maintainer:  Han Boetes <han@mijncomputer.nl>

name=tla
version=1.3.4
release=1
source="
    http://ftp.gnu.org/gnu/gnu-arch/$name-$version.tar.gz
    fix-patch-test.diff
"

build() {
    patch -d $name-$version -p0 < fix-patch-test.diff
    install -d $name-$version/src/build
    cd $name-$version/src/build
    ../configure \
        --prefix=/usr \
	--destdir=$PKG
    make
    make install
}
