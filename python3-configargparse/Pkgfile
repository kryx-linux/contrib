# Description: A drop-in replacement for argparse
# URL: https://github.com/bw2/ConfigArgParse/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-setuptools-scm

name=python3-configargparse
version=1.7.5
release=2
source=(https://pypi.org/packages/source/c/configargparse/configargparse-$version.tar.gz)

build() {
  cd configargparse-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
