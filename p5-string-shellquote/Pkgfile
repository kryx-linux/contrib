# Description: quote strings which are going to pass through the shell
# URL:         http://search.cpan.org/~rosch/String-ShellQuote-1.03/ShellQuote.pm
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  perl

name=p5-string-shellquote
capsname=String-ShellQuote
version=1.03
release=1
source="http://www.cpan.org/modules/by-module/${capsname%%-*}/$capsname-$version.tar.gz"

build()
{
  cd $capsname-$version
  perl Makefile.PL
  make OPTIMIZE="$CFLAGS"
  make install DESTDIR=$PKG
  # Remove perlcrap
  find $PKG \
      -name .packlist -or \
      -name '*.bs' -or \
      -name autosplit.ix -or \
      -name perllocal.pod | xargs rm
  # Remove empty directories
  find $PKG -depth -empty -exec rm -rf {} \;
}
