name=python3-mistune
version=0.8.4
release=1
source=(https://github.com/lepture/mistune/archive/v$version/$name-$version.tar.gz)

build() {
  cd mistune-$version
  /usr/bin/python3 setup.py build
  /usr/bin/python3 setup.py install --optimize=1 --root=$PKG

