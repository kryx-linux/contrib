# Description: kodi inputstream addon for several manifest types
# URL: https://github.com/xbmc/inputstream.adaptive
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: kodi-gbm pugixml

name=kodi-addon-inputstream-adaptive
version=21.5.17
release=1
_bento4=1.6.0-641-3
_codename=Omega

source=(https://github.com/xbmc/inputstream.adaptive/archive/$version-$_codename/$name-$version.tar.gz
  https://github.com/xbmc/Bento4/archive/refs/tags/$_bento4-$_codename.tar.gz)
renames=(SKIP bento4-$_bento4-Omega.tar.gz)

build() {
  cmake -S inputstream.adaptive-$version-$_codename -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS -ffat-lto-objects" \
    -D CMAKE_C_FLAGS_RELEASE="$CFLAGS -ffat-lto-objects" \
    -D BUILD_SHARED_LIBS=ON \
    -D ENABLE_INTERNAL_BENTO4=ON \
    -D BENTO4_URL=$PKGMK_SOURCE_DIR/bento4-$_bento4-Omega.tar.gz \
    -D USE_LTO=ON \
    -D BUILD_TESTING=OFF \
    -Wno-dev
  cmake --build build
  DESTDIR=$PKG cmake --install build
}
