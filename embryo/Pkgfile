# Description: Virtual machine and compiler based on Small for use with E17.
# URL:         http://www.enlightenment.org/
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  ecore
name=embryo
version=cvs
release=1

build()
{
    cd $PKGMK_SOURCE_DIR
    if cd e17/libs/$name ; then
	cvs -z3 -q up -dAP
    else
	cvs -z3 -q -d :pserver:anonymous@anoncvs.enlightenment.org:/var/cvs/e co e17/libs/$name
    fi

    cp -r $PKGMK_SOURCE_DIR/e17/libs/$name $SRC
    cd $SRC/$name

    ./autogen.sh --prefix=/usr
    make
    make install DESTDIR=$PKG
}
