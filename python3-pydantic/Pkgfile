# Description: Data parsing and validation using Python type hints
# URL: https://github.com/samuelcolvin/pydantic
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-hatch-fancy-pypi-readme python3-annotated-types python3-pydantic-core python3-typing-inspection

name=python3-pydantic
version=2.11.5
release=1
source=(https://github.com/samuelcolvin/pydantic/archive/v$version/$name-$version.tar.gz)

build() {
  cd pydantic-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
