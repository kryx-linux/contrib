name=aircrack-ng
version=1.0-rc1
release=1
source=(http://download.aircrack-ng.org/$name-$version.tar.gz)

build() {
    cd $name-$version
    make \
      prefix=/usr \
      SQLITE=false \
      REVISION=0 \
      DESTDIR=$PKG install
}
