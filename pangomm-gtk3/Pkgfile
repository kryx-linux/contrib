# Description: C++ interface to pango.
# URL: https://gitlab.gnome.org/GNOME/pangomm
# Maintainer: John McQuah, jmcquah at disroot dot org
# Depends on: cairomm-1.0 glibmm-gtk3 pango

name=pangomm-gtk3
version=2.46.4
release=1
source=(https://download.gnome.org/sources/${name%-gtk3}/${version%.*}/${name%-gtk3}-$version.tar.xz)

build() {
    meson setup ${name%-gtk3}-$version build \
        --prefix=/usr \
        --buildtype=plain \
        -D b_lto=true \
        -D b_pie=true

    meson compile -C build -j ${JOBS:-1}
    DESTDIR=$PKG meson install -C build
}
