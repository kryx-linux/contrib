# Description: GNU documentation system for on-line information and printed output
# URL: https://www.gnu.org/software/texinfo/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: ncurses

name=texinfo
version=6.8
release=2
source=(https://ftp.gnu.org/gnu/texinfo/$name-$version.tar.xz
  texinfo-6.8-undo-gnulib-nonnul.patch)

build() {
  cd $name-$version

  patch -Np1 -i $SRC/texinfo-6.8-undo-gnulib-nonnul.patch

  ./configure \
    --prefix=/usr \
    --disable-nls
  make
  make DESTDIR=$PKG install
  rm -r $PKG/usr/share/info
}
