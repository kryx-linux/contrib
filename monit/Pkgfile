# Description: Utility for monitoring daemons running on a Unix system
# URL: http://www.tildeslash.com/monit/
# Maintainer: Juergen Daubert, jue at crux dot nu
# Depends on: libnsl libtirpc linux-pam openssl zlib
# Optional: bash-completion

name=monit
version=6.1.0
release=1
source=(http://mmonit.com/$name/dist/$name-$version.tar.gz \
    monitd)

build() {
    cd $name-$version

    prt-get isinst bash-completion || PKGMK_MONIT+=' --with-bashcompletiondir=no'

    ./configure $PKGMK_MONIT \
        --prefix=/usr \
        --sysconfdir=/etc \
        --runstatedir=/run

    make
    make DESTDIR=$PKG install

    install -D -m 0755 $SRC/monitd $PKG/etc/rc.d/monitd
    install -D -m 0700 monitrc $PKG/etc/monitrc
}
