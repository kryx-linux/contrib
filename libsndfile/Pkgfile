# Description: Library for manipulating sound files.
# URL: http://www.mega-nerd.com/libsndfile
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Jay Dolan, jdolan at jdolan dot dyndns dot org
# Depends on: flac alsa-lib
# Optional: sqlite3

name=libsndfile
version=1.0.18pre22
release=1
source=(http://www.mega-nerd.com/tmp/$name-$version.tar.gz
	$name-1.0.18pre22-missing-headers-gcc43.patch)

build() {
	cd $name-$version
	patch -p 1 -i $SRC/$name-1.0.18pre22-missing-headers-gcc43.patch

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--disable-static

	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share
}

