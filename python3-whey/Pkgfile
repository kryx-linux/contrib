# Description: A simple Python wheel builder for simple projects
# URL: https://github.com/repo-helper/whey
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-consolekit python3-pyproject-parser

name=python3-whey
version=0.1.1
release=2
source=(https://pypi.org/packages/source/w/whey/whey-$version.tar.gz)

build() {
  cd whey-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
