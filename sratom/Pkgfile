# Description: An LV2 Atom RDF serialisation library.
# URL: https://gitlab.com/lv2/sratom
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: lv2 sord

name=sratom
version=0.6.22
release=1
source=(https://gitlab.com/lv2/sratom/-/archive/v$version/sratom-v$version.tar.bz2)

build() {
  meson setup $name-v$version build \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true

  meson compile -C build
  DESTDIR=$PKG meson install -C build
}
