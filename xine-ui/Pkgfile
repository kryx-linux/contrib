# Depends on: xine-lib

name=xine-ui
version=0.99.5
release=2
source=(http://downloads.sourceforge.net/sourceforge/xine/$name-$version.tar.gz)

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--disable-nls

	make
	make DESTDIR=$PKG install
	install -d $PKG/usr/share/skins
	rm -fr $PKG/usr/{man/{??,man1/aaxine*},share/doc}
}
