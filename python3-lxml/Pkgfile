# Description: A pythonic binding for the libxml2 and libxslt libraries.
# URL: https://lxml.de/
# Maintainer: John McQuah, jmcquah at disroot dot org
# Depends on: python3-beautifulsoup4 python3-cssselect python3-cython python3-html5lib libxslt

name=python3-lxml
_name=${name#python3-}
version=6.0.0
release=1
source=(https://github.com/$_name/$_name/releases/download/$_name-$version/$_name-$version.tar.gz)

build() {
  cd $_name-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
  find $PKG/usr/lib/python3.12/site-packages/*.dist-info \
    \( -name "LICENSE*" -o -name METADATA -o -name AUTHORS \
    -o -name RECORD -o -name WHEEL \) -delete
}
