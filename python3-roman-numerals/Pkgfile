# Description: Manipulate well-formed Roman numerals
# URL: https://github.com/AA-Turner/roman-numerals/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-wheel

name=python3-roman-numerals
version=3.1.0
release=1
source=(https://pypi.org/packages/source/r/roman_numerals/roman_numerals-$version.tar.gz)

build() {
  cd roman_numerals-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
