name=libmpcdec
version=1.2.2
release=1
source="http://files2.musepack.net/source/libmpcdec-$version.tar.bz2"

build()
{
    cd libmpcdec-$version
    ./configure --prefix=/usr
    make
    make install DESTDIR=$PKG
}
