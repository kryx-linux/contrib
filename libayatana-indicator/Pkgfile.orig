# Description: Ayatana Indicators shared library
# URL: https://github.com/AyatanaIndicators/libayatana-indicator
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: ayatana-ido gobject-introspection gtk3 vala

name=libayatana-indicator
version=0.9.3
release=1
source=(https://github.com/AyatanaIndicators/libayatana-indicator/archive/$version/$name-$version.tar.gz)

build() {
  cmake -S $name-$version -B build-gtk3 -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_INSTALL_LIBDIR=lib \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
    -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
    -D FLAVOUR_GTK3=ON \
    -Wno-dev
  cmake --build build-gtk3

  DESTDIR=$PKG cmake --install build-gtk3
}
