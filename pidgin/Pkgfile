# Description: multi-protocol instant messaging client.
# URL: http://pidgin.im/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Simone Rota, sip at crux dot nu
# Depends on: dbus-glib farstream gtkspell startup-notification xorg-libxscrnsaver nss

name=pidgin
version=2.10.10
release=1
source=(http://downloads.sourceforge.net/project/$name/Pidgin/$version/$name-$version.tar.bz2)

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--enable-cyrus-sasl \
		--disable-nls \
		--disable-schemas-install \
		--disable-meanwhile \
		--disable-avahi \
		--disable-nm \
		--disable-tcl \
		--disable-dependency-tracking \
		--with-system-ssl-certs=/etc/ssl/certs \
		--with-nspr-includes=/usr/include/nspr \
		--with-nss-includes=/usr/include/nss \
		--with-nspr-libs=/usr/lib \
		--with-nss-libs=/usr/lib


	make
	make DESTDIR=$PKG install

	install -D -m 0644 $name.desktop.in $PKG/usr/share/applications/$name.desktop

	find $PKG/usr/lib/ -name '*.la' -delete
	rm -rf $PKG/usr/etc/gconf
}
