# Description: Zope interface library.
# URL: https://pypi.python.org/pypi/zope.interface
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-wheel

name=python3-zope-interface
version=8.0.1
release=1
source=(https://pypi.io/packages/source/z/zope_interface/zope_interface-$version.tar.gz)

build() {
  cd zope_interface-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
