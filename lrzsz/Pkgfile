name=lrzsz
version=0.12.20
release=1
source=(http://www.ohse.de/uwe/releases/$name-$version.tar.gz)

build() {
	cd $name-$version
	./configure --prefix=/usr --disable-nls
	make
	make DESTDIR=$PKG install
}
