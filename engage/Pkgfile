# Description: A program launcher similar to Mac OS dock for use with EFL.
# URL:         http://www.enlightenment.org/
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  e17 emotion

name=engage
version=cvs
release=1

build()
{
    cd $PKGMK_SOURCE_DIR
    if cd e17/misc/$name ; then
	cvs -z3 -q up -dAP
    else
	install -d e17
	cd e17
	cvs -z3 -q -d :pserver:anonymous@anoncvs.enlightenment.org:/var/cvs/e co misc/$name
    fi

    cp -r $PKGMK_SOURCE_DIR/e17/misc/$name $SRC
    cd $SRC/$name

    ./autogen.sh --prefix=/usr
    make
    make install DESTDIR=$PKG
}
