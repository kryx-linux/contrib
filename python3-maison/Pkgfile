# Description: Read settings from config files
# URL: https://github.com/dbatten5/maison
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-loguru python3-platformdirs python3-pydantic python3-typer

name=python3-maison
version=2.0.2
release=1
source=(https://pypi.org/packages/source/m/maison/maison-$version.tar.gz)

build() {
  cd maison-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
