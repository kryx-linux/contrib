# Description: Python network library that uses greenlet and libev for easy and scalable concurrency
# URL: https://www.gevent.org/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: c-ares libev python3-cython python3-greenlet python3-zope-event python3-zope-interface

name=python3-gevent
version=26.5.0
release=1
source=(https://github.com/gevent/gevent/archive/$version/$name-$version.tar.gz)

build() {
  cd gevent-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
