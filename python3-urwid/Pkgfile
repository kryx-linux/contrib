# Description: Console user interface library for Python
# URL: https://urwid.org/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-typing_extensions python3-wcwidth

name=python3-urwid
version=3.0.5
release=1
source=(https://pypi.org/packages/source/u/urwid/urwid-$version.tar.gz)

build() {
  cd urwid-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
