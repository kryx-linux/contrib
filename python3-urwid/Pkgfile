# Description: Console user interface library for Python
# URL: https://urwid.org/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-setuptools-scm

name=python3-urwid
version=2.5.3
release=1
source=(https://pypi.org/packages/source/u/urwid/urwid-$version.tar.gz)

build() {
  cd urwid-$version
  /usr/bin/python3 setup.py build
  /usr/bin/python3 setup.py install \
    --prefix=/usr \
    -O1 \
    --skip-build \
    --root=$PKG
}
