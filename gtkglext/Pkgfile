# Description: OpenGL extension to GTK 2.0.
# URL: https://web.archive.org/web/20170805202534/https://projects.gnome.org/gtkglext/
# Maintainer: Danny Rawlins, crux at romster dot me
# Depends on: glu gtk pangox-compat xorg-libxmu

name=gtkglext
version=1.2.0
release=3
source=(https://downloads.sourceforge.net/project/$name/$name/$version/$name-$version.tar.gz
	gtk2.20.patch
	gtkglext-gcc8.patch)

build() {
	cd $name-$version

	patch -p1 -i $SRC/gtk2.20.patch
	sed '/AC_PATH_XTRA/d' -i configure.in
	patch -p1 -i $SRC/gtkglext-gcc8.patch

	autoreconf -vi

	./configure \
		--prefix=/usr \
		--disable-gtk-doc

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/share
}
