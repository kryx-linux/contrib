name=pyspeex
version=0.2
release=1
source=(http://www.freenet.org.nz/python/pySpeex/pySpeex-$version.tar.gz)

build() {
	cd pySpeex-$version
	python setup.py install --root=$PKG
	chown -R root:root $PKG
}
