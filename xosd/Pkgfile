# Description: Library to print onscreen information in X11.
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# URL:         http://www.ignavus.net/software.html
# Depends on:  x11

name=xosd
version=2.2.14
release=1
source="http://dl.sourceforge.net/sourceforge/libxosd/$name-$version.tar.gz"

build ()
{
    cd $name-$version
    ./configure \
	--prefix=/usr \
	--disable-nls
    make
    make DESTDIR=$PKG install
}
