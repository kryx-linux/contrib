#!/bin/sh

#
# It's even better if you make a special useraccount for this server.
#

case $1 in
    start)
	# run privoxy as user nobody.
	su - nobody -c '/usr/sbin/privoxy /etc/privoxy/config &'
	;;
    stop)
	pkill -f '/usr/sbin/privoxy'
	;;
    restart)
	$0 stop
	sleep 5
	$0 start
	;;
esac

# End of file
