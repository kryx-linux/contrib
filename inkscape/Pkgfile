# Description: An open source SVG editor.
# URL: http://www.inkscape.org
# Maintainer: Jose V Beneyto, sepen at users dot sourceforge dot net
# Packager: Huynh Ngoc Chau Tran, tran.huynh at laposte dot net
# Depends on: libart_lgpl,boehm-gc,gtkmm,pyxml

name=inkscape
version=0.45.1
release=1
source=(http://dl.sourceforge.net/${name}/${name}-${version}.tar.gz \
        libsigc-fix.patch)

build() {
	cd ${name}-${version}
	patch -p0 < ${SRC}/libsigc-fix.patch
	./configure \
		--prefix=/usr \
		--disable-static \
		--disable-nls
  make
	make DESTDIR=${PKG} install
  rm -dr ${PKG}/usr/share/locale
	find ${PKG}/usr/share -type f -name README -exec rm -f {} \;
}
