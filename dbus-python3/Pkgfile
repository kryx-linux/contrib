# Description: D-Bus Python bindings
# URL: http://freedesktop.org/wiki/Software/DBusBindings
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: dbus-glib python3-wheel

name=dbus-python3
version=1.5.1
release=1
source=(https://dbus.freedesktop.org/releases/dbus-python/dbus_python-$version.tar.gz)

build() {
  meson setup dbus_python-$version build \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true
  meson compile -C build
  DESTDIR=$PKG meson install -C build
}
