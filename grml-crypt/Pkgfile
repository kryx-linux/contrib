# Description: practical wrapper for cryptsetup-luks
# URL: http://www.grml.org
# Maintainer: Simon Gloﬂner, viper at hometux dot de
# Depends on: realpath, grml-shlib

name=grml-crypt
version=0.15
release=1
source=(http://deb.grml.org/pool/main/g/$name/${name}_${version}.tar.gz \
	$name-$version.patch)

build() {
    cd $name-$version

    patch -p1 < $SRC/$name-$version.patch

    mkdir -p $PKG/usr/sbin
    mkdir -p $PKG/usr/man/man8

    install -m 755 grml-crypt $PKG/usr/sbin
    install -m 644 grml-crypt.8.gz $PKG/usr/man/man8
}
