# Description: U-Boot tools
# URL: https://www.denx.de/wiki/U-Boot/WebHome
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: dtc gnutls swig

name=u-boot-tools
version=2026.10
release=1
source=(https://git.u-boot-project.org/u-boot/u-boot/-/archive/v$version/u-boot-v$version.tar.bz2)

build() {
  cd u-boot-v$version

  make sandbox_config
  make tools TOOLSUBDIRS=""

  install -d -m 0755 $PKG/usr/{bin,share/man/man1}
  install -m 0755 tools/mk{,env}image $PKG/usr/bin
  install -m 0644 doc/mkimage.1 $PKG/usr/share/man/man1
}
