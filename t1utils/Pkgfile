name=t1utils
version=1.32
release=1
source="http://www.lcdf.org/~eddietwo/type/$name-$version.tar.gz"

build() {
    cd $name-$version
    ./configure \
        --prefix=/usr \
        --disable-nls
    make
    make install DESTDIR=$PKG
}
