# Packager:    Jochem Kossen
# URL:         http://bluefish.openoffice.nl/
# Description: Editor for experienced web designers and programmers
# Depends on:  libpcre aspell gtk

name=bluefish
version=1.0.6
release=1
source="
    http://www.bennewitz.com/bluefish/stable/source/bluefish-$version.tar.gz
    $name.diff
"

build()
{
    cd $name-$version
    patch -p0 -b -z .orig < $SRC/$name.diff
    ./configure \
	--prefix=/usr \
	--disable-update-databases \
	--enable-bookmarks
    make
    make install DESTDIR=$PKG
}
