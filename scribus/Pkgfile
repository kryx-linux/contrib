# Description: layout tool
# URL:         http://scribus.net
# Maintainer:  Thomas Penteker, tek at serverop dot de
#
# Depends on:  libart_lgpl

name=scribus
version=1.3.3.13
release=1
source=(http://dl.sourceforge.net/$name/$name-$version.tar.bz2)

build() {
   cd $name-$version

   ./configure \
      --prefix=/usr \
      --disable-nls \
      --mandir=/usr/man

   make && make DESTDIR=$PKG install
   rm -rf $PKG/usr/doc
   rm -rf $PKG/usr/man/pl
   rm -rf $PKG/usr/share/doc/$name-$version/{AUTHORS,COPYING,ChangeLog,ChangeLogSVN,INSTALL,NEWS,README,README.MacOSX,TODO}
   rm -rf $PKG/usr/share/scribus/dicts/README_*
}
