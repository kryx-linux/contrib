# Description: integrated tex/latex environment for emacs
# URL:         http://www.gnu.org/software/auctex/
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  emacs tetex

name=auctex
version=11.82
release=1
source="http://ftp.gnu.org/pub/gnu/$name/$name-$version.tar.gz"

build()
{
    cd $name-$version
    export TEXMFDIR=/usr/share/texmf
    ./configure \
        --prefix=/usr \
        --with-emacs \
        --with-texmf-dir=/usr/share/texmf \
	--disable-preview
    # Now preview is pretty nifty so you may want to enable it
    # anyway. But it will conflict with preview installed by
    # tetex. No biggy. =}

    make
    make install DESTDIR=$PKG
    # remove .el source files if compiled versions also exist.
    find \
        $PKG/usr/share/emacs/ \
        -name "*.el"| while read line; do
        if [ -r ${line}c ]; then
            rm $line
        fi
    done
    rm -rf \
        $PKG/usr/var/ \
        $PKG/usr/share/emacs/site-lisp/auctex/style/.nosearch \
	$PKG/usr/info/dir
}
