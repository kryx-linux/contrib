# Description: Simplified packaging of Python modules
# URL: https://github.com/takluyver/flit
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-flit-core python3-docutils python3-requests python3-tomli python3-pip

name=python3-flit
version=3.8.0
release=1
source=(https://github.com/takluyver/flit/archive/$version/flit-$version.tar.gz)

build() {
  rm flit-$version/tests/test_sdist.py

  cd flit-$version/flit_core
  /usr/bin/python3 build_dists.py
  cd ..
  PYTHONPATH=flit_core /usr/bin/python3 -m flit build --format wheel
  PIP_CONFIG_FILE=/dev/null /usr/bin/pip3 install --isolated --root=$PKG --ignore-installed --no-deps $SRC/flit-$version/dist/*.whl
}
