# Description: Basic HBCI interface
# URL: http://www.aquamaniac.de/aqbanking/
# Maintainer: Simon Gloﬂner, viper at hometux dot de
# Depends on: ktoblzcheck, gwenhywfar, qt3

name=aqbanking
version=2.2.9
release=1
source=(http://dl.sourceforge.net/${name}/${name}-${version}.tar.gz)
    
build() {
    cd $name-$version

    ./configure \
	--prefix=/usr \
	--disable-kde \
	--enable-gwenhywfar \
	--with-backends=aqhbci \
	--with-frontends="cbanking qbanking"
    make 
    make DESTDIR=$PKG install

    rm -f $PKG/usr/bin/qb-help
    rm -f $PKG/usr/include/qbanking/qbhelpbrowser.{h,ui.h}
    rm -rf $PKG/usr/share/doc
    rm -rf $PKG/usr/share/locale
    rm -rf $PKG/usr/share/aqbanking/i18n
    rm -rf $PKG/usr/share/aqbanking/frontends
}
