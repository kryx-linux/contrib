name=makeself
version=2.1.5
release=1
source=(http://www.megastep.org/$name/$name-$version.run)

build() {
  sh $name-$version.run
  mkdir -p $PKG/usr/bin
  install -D -m 0755 $name-$version/$name.sh $PKG/usr/bin/$name
}
