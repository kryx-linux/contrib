# Description: An ISO 8601 date/time parser.
# URL: https://pypi.org/project/isodate/
# Maintainer: John McQuah, jmcquah at disroot dot org
# Depends on: python3-six python3-wheel

name=python3-isodate
_name=${name#python3-}
version=0.7.2
release=1
source=(https://files.pythonhosted.org/packages/source/${_name:0:1}/$_name/$_name-$version.tar.gz)

build() {
  cd $_name-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir="$PKG" dist/*.whl
  find "$PKG/usr/lib/python3.12/site-packages" \
       \( -name LICENSE  -o -name WHEEL \
       -o -name METADATA -o -name RECORD \) -delete
}
