name=xorg-lndir
version=1.0.1
release=1
source="http://xorg.freedesktop.org/releases/individual/util/lndir-$version.tar.gz"

build()
{
    cd lndir-$version
    ./configure --prefix=/usr
    make
    make install DESTDIR=$PKG
}
