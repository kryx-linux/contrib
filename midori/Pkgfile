# Description: Midori is a lightweight web browser.
# URL: http://www.midori-browser.org/
# Maintainer: Danny Rawlins, crux at romster dot me
# Packager: Brett Goulder, predatorfreak at dcaf-security dot org
# Depends on: aria2 desktop-file-utils gst-libav gst-plugins-good libnotify librsvg libzeitgeist ninja webkit-gtk2 xorg-libxscrnsaver

name=midori
version=0.5.9
release=1
source=(http://midori-browser.org/downloads/${name}_${version}_all_.tar.bz2)

build() {
	cd $name-$version

	install -d build
	cd build

	cmake .. \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-G Ninja

	ninja
	DESTDIR=$PKG ninja install

	rm -r $PKG/usr/share/{doc,locale}
}
