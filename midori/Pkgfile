# Description: Midori is a lightweight web browser.
# URL: http://www.midori-browser.org/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Brett Goulder, predatorfreak at dcaf-security dot org
# Depends on: libnotify librsvg vala webkit xorg-libxscrnsaver libunique

name=midori
version=0.5.5
release=1
source=(http://www.midori-browser.org/downloads/${name}_${version}_all_.tar.bz2)

build() {
	cd $name-$version
	local JOBS="$(sed -e 's/.*\(\-j[ 0-9]\+\) \{0,1\}.*/\1/' <<< $MAKEFLAGS)"
	./configure --prefix=/usr --disable-zeitgeist $JOBS
	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share/{doc,locale}
}
