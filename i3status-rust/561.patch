+fn extract_artist_from_value(value: &dyn arg::RefArg) -> Result<&str> {
+    if let Some(artist) = value.as_str() {
+        Ok(artist)
+    } else {
+        extract_artist_from_value(
+            value
+                .as_iter()
+                .block_error("music", "failed to extract artist")?
+                .next()
+                .block_error("music", "failed to extract artist")?,
+        )
+    }
+}
