# Description: An all-platform Edonkey client.
# URL: http://www.amule.org/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Antti Nykanen, aon at iki dot fi
# Depends on: crypto++ util-linux wxgtk

name=amule
version=2.3.1
release=1
source=(http://downloads.sourceforge.net/project/amule/aMule/$version/aMule-$version.tar.xz)

build() {
	cd aMule-$version

	export CFLAGS="${CFLAGS//-fstack-protector/}"
	export CXXFLAGS="${CXXFLAGS//-fstack-protector/}"

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--disable-nls

	make
	make install DESTDIR=$PKG
	rm -r $PKG/usr/share/doc
}
