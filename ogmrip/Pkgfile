# Description: gnome ripper using mencoder, ogmtools, oggenc and lame
# URL:         http://ogmrip.sf.net
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  gconf libdvdread libglade mplayer ogmtools
# Nice to have: mkvtoolnix gocr enchant (both not packaged)

name=ogmrip
version=0.10.0-rc1
release=1
source="http://dl.sourceforge.net/sourceforge/$name/$name-$version.tar.gz"

build()
{
    cd $name-$version
    ./configure \
        --prefix=/usr \
        --disable-nls
    make
    make install DESTDIR=$PKG
    rm -r $PKG/usr/share/locale
}
