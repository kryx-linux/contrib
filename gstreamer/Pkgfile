# Description: Gstreamer is a library that allows the construction of graphs of media-handling components.
# URL: http://gstreamer.freedesktop.org/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Matt Housh, jaeger at morpheus dot net
# Depends on: libxml2 glib python

name=gstreamer
version=0.10.21
release=1
source=(http://gstreamer.freedesktop.org/src/gstreamer/gstreamer-$version.tar.bz2
	gstreamer-0.10.21-disable-gtkdoc.patch)

build() {
	cd gstreamer-$version

	patch -p 1 -i $SRC/gstreamer-0.10.21-disable-gtkdoc.patch
	automake

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--disable-static \
		--disable-nls \
		--disable-gst-debug \
		--disable-debug \
		--disable-examples \
		--disable-valgrind \
		--disable-gtk-doc \
		--disable-docbook

	make
	make DESTDIR=$PKG install
}

