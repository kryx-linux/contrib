# Description: A helper class for handling configuration defaults of packaged apps gracefully
# URL: https://django-appconf.readthedocs.io/
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Depends on: python3-django

name=python3-django-appconf
version=1.2.0
release=1
source=(https://pypi.org/packages/source/d/django_appconf/django_appconf-$version.tar.gz)

build() {
  cd django_appconf-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
