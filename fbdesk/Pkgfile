# Description: fluxbox-util that creates and manages icons for fluxbox
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Olle Gustafsson <ogg@linux.se>
# URL:         http://fluxbox.sourceforge.net/fbdesk/

name=fbdesk
version=1.4.0
release=1
source="http://fluxbox.sourceforge.net/download/$name-$version.tar.gz"

build ()
{
    cd $name-$version
    ./configure \
        --prefix=/usr \
        --disable-nls
    make
    make install DESTDIR=$PKG
}
