# Description: pager for fluxbox
# URL:         http://fluxbox.org/fbpager/
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  x11

name=fbpager
version=0.1.4
release=1
source="http://fluxbox.org/download/$name-$version.tar.gz"

build() {
    cd $name-$version
    ./configure \
        --prefix=/usr \
        --disable-nls
    make
    make install DESTDIR=$PKG
}
