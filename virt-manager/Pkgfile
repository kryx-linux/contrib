# Description: A desktop user interface for managing virtual machines through libvirt
# URL: https://virt-manager.org/
# Maintainer: Matt Housh, jaeger at crux dot ninja
# Depends on: gtk-vnc gtksourceview libosinfo libvirt-glib libvirt-python python3-gobject python3-requests vte3

name=virt-manager
version=5.1.0
release=1
source=(https://releases.pagure.org/virt-manager/$name-$version.tar.xz)

build() {
  meson setup $name-$version build \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true \
    -D update-icon-cache=false \
    -D compile-schemas=false \
    -D tests=disabled
  meson compile -C build
  DESTDIR=$PKG meson install -C build

  rm -r $PKG/usr/share/locale
}
