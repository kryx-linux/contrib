# Maintainer:  Han Boetes <han@mijncomputer.nl>
# URL:         http://google.com
# Description: converts rpms to tarballs

name=rpm2targz
version=1.0.3
release=9
source="
    rpm2targz
    rpmoffset.c
"

build()
{
    gcc $CFLAGS rpmoffset.c -o rpmoffset
    install -d $PKG/usr/bin  $PKG/usr/lib/rpm2targz
    install -m 755 rpm2targz $PKG/usr/bin
    install -m 755 rpmoffset $PKG/usr/lib/rpm2targz
}
