# Description: Build backend for CMake based projects
# URL: https://github.com/scikit-build/scikit-build-core
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-exceptiongroup python3-hatch-vcs

name=python3-scikit-build-core
version=0.12.0
release=1
source=(https://pypi.org/packages/source/s/scikit_build_core/scikit_build_core-$version.tar.gz)

build() {
  cd scikit_build_core-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
