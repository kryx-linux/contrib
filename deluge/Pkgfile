# Description: A bittorrent client based on Python and GTK.
# URL: http://deluge-torrent.org/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Brett Goulder, predatorfreak at dcaf-security dot org.
# Depends on: dbus-python librsvg libtorrent-rasterbar pygtk pyopenssl python2-chardet pyxdg setuptools twisted

name=deluge
version=1.3.1
release=1
source=(http://download.deluge-torrent.org/source/$name-$version.tar.lzma)

build() {
	cd $name-$version
	ARCH='x86' OS='linux' python setup.py build
	python setup.py install --root=$PKG install

	# deluge wont run without this
	#find $PKG -name '*.egg-info' | xargs rm -rf
}
