# Description: Python toolkit for generation of output for the web 
# URL: http://genshi.edgewall.org 
# Maintainer:  Thomas Penteker, tek at serverop dot de
# Packager: Victor Martinez, pitillo at ono dot com 
# Depends on: python

name=genshi
version=0.5.1
release=1
source=(http://ftp.edgewall.com/pub/genshi/Genshi-$version.tar.bz2)

build() {
  cd Genshi-$version
  python setup.py install --prefix=/usr --root=$PKG
  rm -r $PKG/usr/lib/python2.6/site-packages/Genshi-0.5.1-py2.6.egg-info
}
