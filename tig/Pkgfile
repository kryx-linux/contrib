name=tig
version=2.0.2
release=1
source=(http://jonas.nitro.dk/$name/releases/$name-$version.tar.gz) 

build() {
  cd $name-$version

  ./configure --prefix=/usr --mandir=/usr/man --sysconfdir=/etc

  make LDLIBS="-lncursesw -lreadline"
  make prefix=/usr DESTDIR=$PKG install
