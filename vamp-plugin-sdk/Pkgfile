# Description: The Vamp audio analysis plug-in system
# URL: https://vamp-plugins.org/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: libsndfile

name=vamp-plugin-sdk
version=2.10.0
release=2
source=(https://github.com/vamp-plugins/vamp-plugin-sdk/releases/download/vamp-plugin-sdk-v${version::4}/vamp-plugin-sdk-$version.tar.gz)

build() {
  cd $name-$version

  export LIBDIR=lib
  export CFLAGS="$CFLAGS -fPIC -Wall"
  export CXXFLAGS="$CFLAGS -fPIC -Wall"

  ./configure --prefix=/usr

  make -j1

  make DESTDIR=$PKG -j1 install

  find $PKG/usr/lib \(\
    -name '*.a' -o \
    -name '*.la' \
    \) -print -delete
}
