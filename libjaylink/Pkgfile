# Description: a shared library written in C to access SEGGER J-Link and compatible devices
# URL: https://gitlab.zapb.de/libjaylink/libjaylink
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: libusb

name=libjaylink
version=0.3.1
release=1
source=(https://gitlab.zapb.de/libjaylink/libjaylink/-/archive/$version/$name-$version.tar.bz2)

build() {
  cd $name-$version

  ./autogen.sh
  ./configure --prefix=/usr
  make
  make DESTDIR=$PKG install
}
