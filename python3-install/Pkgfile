# Description: A simple, correct PEP427 wheel installer
# URL: https://github.com/FFY00/python-install
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-setuptools

name=python3-install
version=0.0.3
release=1
source=(https://pypi.io/packages/source/p/python-install/python-install-$version.tar.gz)

build() {
  cd python-install-$version
  /usr/bin/python3 setup.py build
  /usr/bin/python3 setup.py install --prefix=/usr \
    --root=$PKG \
    --skip-build \
    -O1
}
