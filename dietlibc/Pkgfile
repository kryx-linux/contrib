# Description: DietC is a libc that is optimized for size.
# URL: http://www.fefe.de/dietlibc/
# Maintainer: Alan Mizrahi, alan at mizrahi dot com dot ve
# Depends on: 

name=dietlibc
version=0.31
release=1

source=(http://www.kernel.org/pub/linux/libs/$name/$name-$version.tar.bz2)

build() {
	cd $name-$version
	mkdir -p $PKG/{etc,usr} 
	make prefix=/usr/dietlibc
	make prefix=/usr/dietlibc dyn
	make prefix=/usr/dietlibc DESTDIR=$PKG install
	mv $PKG/usr/dietlibc/man $PKG/usr
	ln -s libc.a $PKG/usr/dietlibc/lib-i386/dietlibc.a
	ln -s lib-i386 $PKG/usr/dietlibc/lib
}
