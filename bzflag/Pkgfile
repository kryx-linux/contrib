# Description: Fast, 3D multiplayer tank battle game
# URL:         http://bzflag.org/
# Maintainer:  Han Boetes <han@mijncomputer.nl>


name=bzflag
version=2.0.0
release=1
extra_bullshit_version=20050117
source="http://dl.sourceforge.net/sourceforge/$name/$name-$version.$extra_bullshit_version.tar.bz2"

build () {
    cd $name-$version.$extra_bullshit_version
    ./configure \
        --prefix=/usr \
        --disable-nls
    make
    make install DESTDIR=$PKG
    cd misc
    install -d $PKG/usr/share/$name/misc
    install -m 0755 \
        bzfquery.pl \
        bzwcvt.pl \
        mrtg-bzflag.pl $PKG/usr/share/$name/misc
    install -m 0644 \
        bzfs.conf \
        bzfs_conf.html \
        bzlist.php \
        groups.conf $PKG/usr/share/$name/misc
    rm -rf $PKG/usr/share/bzflag/l10n/
}
