# Description: GTK Interface Builder.
# URL:         http://glade.gnome.org/
# Maintainer:  Thomas Penteker, tek at serverop dot de
# Depends on:  docbook-xsl gtk3 libglade libxslt itstool

name=glade3
version=3.36.0
release=1
source=(http://ftp.gnome.org/pub/GNOME/sources/glade/${version::4}/glade-$version.tar.xz)

build() {
   cd glade-$version

   ./configure \
      --prefix=/usr \
      --disable-gnome

   make && make DESTDIR=$PKG install
   ln -sf /usr/bin/glade-3 $PKG/usr/bin/glade
   rm -rf $PKG/usr/share/{locale,gnome,omf,gtk-doc,help}
}
