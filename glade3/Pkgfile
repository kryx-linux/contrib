# Description: GTK Interface Builder.
# URL:         http://glade.gnome.org/
# Maintainer:  Thomas Penteker, tek at serverop dot de
# Depends on:  libglade, p5-xml-parser, gtk

name=glade3
version=3.6.3
release=1
source=(http://ftp.gnome.org/pub/GNOME/sources/$name/3.6/$name-$version.tar.bz2)

build() {
   cd $name-$version

   ./configure \
      --prefix=/usr \
      --disable-gnome

   make && make DESTDIR=$PKG install
   ln -sf /usr/bin/glade-2 $PKG/usr/bin/glade
   rm -rf $PKG/usr/share/{locale,gnome,omf}
}
