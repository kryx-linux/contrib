#
# /etc/rc.d/nginx: start, stop or retart nginx server
#

case $1 in
    start)
	if [ -s /var/run/nginx.pid ]
	then
	    echo "nginx is already running"
	    exit 1
	fi
	/usr/sbin/nginx
	;;
    stop)
	kill -9 `cat /var/run/nginx.pid`
	;;
    *)
	echo "usage: nginx [start|stop]"
	;;
esac

# End of file
