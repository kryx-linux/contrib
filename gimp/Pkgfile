# Description: The GIMP
# URL: https://www.gimp.org/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: appstream-glib gegl libart_lgpl libxslt mypaint-brushes poppler-data xorg-libxmu
# Optional:  ghostscript gimp-print libheif libmng libsdl libwebp lua openexr openmp vala xorg-libxcursor xorg-libxpm

name=gimp
version=3.0.0
release=1
source=(https://download.gimp.org/pub/gimp/v${version%.*}/$name-$version.tar.xz
  0001-no-check-update.patch)

build() {

  meson setup $name-$version build \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true \
    -D check-update=no
  meson compile -C build
  DESTDIR=$PKG meson install -C build

  mv $PKG/usr/share/man/man1/gimp-console{-${version%.*}.1,.1}
  rm -r $PKG/usr/share/locale
}
