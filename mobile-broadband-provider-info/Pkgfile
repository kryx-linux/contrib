# Description: contains mobile broadband settings for different service providers
# URL: https://git.gnome.org/browse/mobile-broadband-provider-info
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on:  libxslt

name=mobile-broadband-provider-info
version=20251101
release=1
source=(https://gitlab.gnome.org/GNOME/mobile-broadband-provider-info/-/archive/$version/mobile-broadband-provider-info-$version.tar.gz)

build() {
  meson setup $name-$version build \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true
  meson compile -C build
  DESTDIR=$PKG meson install -C build
}
