# Description: PKCS#11 wrapper library
# URL: https://github.com/OpenSC/libp11
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on:

name=libp11
version=0.4.19
release=2
source=(https://github.com/OpenSC/libp11/releases/download/libp11-$version/libp11-$version.tar.gz
  libp11-0.4.19-install-libp11-headers.patch)

build() {
  cd $name-$version

  patch -Np1 -i $SRC/libp11-0.4.19-install-libp11-headers.patch

  ./configure --prefix=/usr \
    --disable-static
  make
  make DESTDIR=$PKG install

  rm -rf $PKG/usr/share/doc
}
