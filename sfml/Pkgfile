# Description: A simple, fast, cross-platform, and object-oriented multimedia API.
# URL: http://www.sfml-dev.org/
# Maintainer: Danny Rawlins, crux at romster dot me
# Packager: Danny Rawlins, crux at romster dot me
# Depends on: freetype glew libjpeg-turbo libsndfile openal xorg-libxrandr xorg-xcb-util-image

name=sfml
version=2.4.0
release=1
source=(http://www.sfml-dev.org/files/SFML-2.4.0-sources.zip)

build() {
	cd SFML-$version

	install -d build
	cd build

	cmake .. \
		-DCMAKE_BUILD_TYPE='Release' \
		-DCMAKE_INSTALL_PREFIX='/usr' \
		-DSFML_BUILD_EXAMPLES=1 \
		-DSFML_BUILD_DOC=0 \
		-DSFML_INSTALL_PKGCONFIG_FILES=1

	make
	make DESTDIR=$PKG install
}
