# Description: libbpf is a C-based library containing a BPF loader
# URL: https://github.com/libbpf/libbpf
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: elfutils rsync zlib

name=libbpf
version=1.6.1
release=1
source=(https://github.com/libbpf/libbpf/archive/v$version/$name-$version.tar.gz)

build() {
  cd $name-$version
  make -C src
  make -C src DESTDIR=$PKG LIBSUBDIR=lib install install_headers
}
