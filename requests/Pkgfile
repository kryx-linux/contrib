name=requests
version=2.2.1
release=1
source=(http://pypi.python.org/packages/source/${name:0:1}/$name/$name-$version.tar.gz)

build() {
	cd $name-$version

	/usr/bin/python setup.py build
	/usr/bin/python setup.py install --prefix=/usr --root=$PKG
}
