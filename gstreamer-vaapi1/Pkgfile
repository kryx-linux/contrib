# Depends on: gst-plugins-base1 gst-plugins-bad1 libva xorg-libxrandr

name=gstreamer-vaapi1
version=0.5.8
release=1
source=(http://www.freedesktop.org/software/vaapi/releases/gstreamer-vaapi/gstreamer-vaapi-$version.tar.bz2
	https://gitorious.org/vaapi/gstreamer-videoutils/raw/f56f0ca70eaa39dc8f66f61e991094b385ed71ff:gst-libs/gst/video/gstvideoencoder.c
	https://gitorious.org/vaapi/gstreamer-videoutils/raw/f56f0ca70eaa39dc8f66f61e991094b385ed71ff:gst-libs/gst/video/gstvideoencoder.h)

build() {
	cd gstreamer-vaapi-$version

	# Fix files not in tarball
	cp $SRC/gstvideoencoder.{c,h} ext/videoutils/gst-libs/gst/video

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--with-gstreamer-api=1.0

	make
	make DESTDIR=$PKG install
}
