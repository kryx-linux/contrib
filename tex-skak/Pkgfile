# Description: Chess fonts for TeX/LateX. Use it to typeset moves, games and diagrams
# URL:         http://
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>
# Depends on:  tetex

name=tex-skak
version=1.2
release=2
source="http://ftp.debian.org/debian/pool/main/t/tex-skak/tex-skak_1.2.orig.tar.gz"

build() {
    cd tex-archive/fonts/skak
    install -d                 $PKG/usr/share/tex-skak
    install -m 644 doc/*.tex   $PKG/usr/share/tex-skak
    install -d                 $PKG/usr/share/texmf/fonts/source/public/skak
    install -m 644 mf/*        $PKG/usr/share/texmf/fonts/source/public/skak
    install -d                 $PKG/usr/share/texmf/tex/generic/skak
    install -m 644 tex/*       $PKG/usr/share/texmf/tex/generic/skak
    install -d                 $PKG/usr/share/texmf/fontname
    install -m 644 special.map $PKG/usr/share/texmf/fontname/skak.map
    find $PKG/usr/share/texmf -name '*.tex' -exec mv {} $PKG/usr/share/tex-skak \;
}
