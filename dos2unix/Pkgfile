# Description: DOS/Mac to Unix text file format converter
# Maintainer: Matt Housh, jaeger at crux dot ninja
# URL: https://waterlander.net/dos2unix/

name=dos2unix
version=7.5.6
release=1
source=(https://waterlander.net/$name/files/$name-$version.tar.gz)

build() {
  cd $name-$version
  make
  make DESTDIR=$PKG install
  rm -r $PKG/usr/share/{doc,locale,man/??{,_??}}
}
