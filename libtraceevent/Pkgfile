# Description: Linux kernel trace event library
# URL: https://git.kernel.org/pub/scm/libs/libtrace/libtraceevent.git/about/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on:

name=libtraceevent
version=1.8.4
release=1
source=(https://git.kernel.org/pub/scm/libs/libtrace/libtraceevent.git/snapshot/$name-$version.tar.gz)

build() {
  cd $name-$version

  make EXTRA_CFLAGS="$CFLAGS"
  make libdir_relative=lib prefix=/usr DESTDIR="$PKG/" install
}
