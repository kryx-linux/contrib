# Description: blingful character graphics/TUI library. definitely not curses
# URL: https://nick-black.com/dankwiki/index.php/Notcurses
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: ffmpeg libdeflate libunistring ninja
# Optional: libqrcodegen ffmpeg python3-cffi python3-pypandoc pandoc-bin

name=notcurses
version=3.0.17
release=1
source=(https://github.com/dankamongmen/notcurses/archive/v$version/$name-$version.tar.gz)

build() {
  prt-get isinst pandoc-bin || PKGMK_NOTCURSES+=' -D USE_PANDOC=OFF'

  cmake -S $name-$version -B build -G Ninja $PKGMK_NOTCURSES \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_INSTALL_LIBDIR=lib \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
    -D USE_DOCTEST=OFF \
    -Wno-dev
  cmake --build build
  DESTDIR=$PKG cmake --install build

  rm -r $PKG/usr/share/doc
}
