# Description: a general-purpose command-line fuzzy finder
# URL: https://github.com/junegunn/fzf/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: go

name=fzf
version=0.43.0
release=1
source=(https://github.com/junegunn/fzf/archive/$version/$name-$version.tar.gz)

build() {
  cd $name-$version

  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"

  mkdir "$PKGMK_SOURCE_DIR/gopath" || true
  export GOPATH="$PKGMK_SOURCE_DIR/gopath"

  go build \
    -trimpath \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -o $name .
  go build -o $name .

  install -dm755 $PKG/usr/bin
  install -m755 fzf bin/fzf-tmux $PKG/usr/bin/

  install -dm755 $PKG/usr/share/fzf
  install -m644 shell/*.bash shell/*.zsh $PKG/usr/share/fzf
}
