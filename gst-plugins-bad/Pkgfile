# Description: A set of plugins for gstreamer that may pose distribution problems.
# URL: http://gstreamer.freedesktop.org/modules/gst-plugins-bad.html
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Matt Housh, jaeger at morpheus dot net
# Depends on: curl faad2 gst-plugins-base libdca libdvdnav libmms libmpcdec libmusicbrainz librsvg libsndfile mjpegtools openldap

name=gst-plugins-bad
version=0.10.23
release=3
source=(http://gstreamer.freedesktop.org/src/$name/$name-$version.tar.xz)

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--disable-debug \
		--disable-nls \
		--disable-dependency-tracking \
		--disable-valgrind \
		--disable-examples

	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share/gtk-doc
}
