# Description: an open-source parametric 3D CAD application built in pure Rust
# URL: https://solidcraft.io/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: rust

name=solidcraft
version=0.50.0
release=1
source=(https://github.com/tangency-labs/solidcraft/archive/v$version/$name-$version.tar.gz)

build() {
  prt-get isinst sccache && export RUSTC_WRAPPER=/usr/bin/sccache
  [[ ! -e $PKGMK_SOURCE_DIR/rust ]] && mkdir $PKGMK_SOURCE_DIR/rust

  sed -i "/let commit = git(/,+1 s/\"unknown\"/\"-\"/" \
    $name-$version/crates/ui-egui/build.rs

  cargo build --release --locked -p solidcraft -p solidcraft-cli \
    --manifest-path $name-$version/Cargo.toml

  sed -e "s/@VERSION@/$version/" -e "s/@DATE@/$(date -u +%Y-%m-%d)/g" \
    $name-$version/assets/platforms/linux/io.tangencylabs.solidcraft.metainfo.xml.in \
    > io.tangencylabs.solidcraft.metainfo.xml

  install -Dt $PKG/usr/bin $name-$version/target/release/$name
  install -Dt $PKG/usr/bin $name-$version/target/release/${name}-cli
  install -Dm644 -t $PKG/usr/share/applications \
    $name-$version/assets/platforms/linux/io.tangencylabs.solidcraft.desktop
  install -Dm644 -t $PKG/usr/share/metainfo \
    io.tangencylabs.solidcraft.metainfo.xml
  install -Dm644 \
    $name-$version/assets/platforms/linux/io.tangencylabs.solidcraft.mime.xml \
    $PKG/usr/share/mime/packages/io.tangencylabs.solidcraft.xml

  for size in 16 24 32 48 64 128 256 512; do
    d="${size}x${size}"
    install -Dm644 -t $PKG/usr/share/icons/hicolor/$d/apps/ \
      $name-$version/assets/icons/app/linux/exports/hicolor/$d/apps/io.tangencylabs.solidcraft.png
  done
}
