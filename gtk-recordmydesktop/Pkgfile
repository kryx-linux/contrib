# Description: Graphical frontend to recordmydesktop
# URL: http://recordmydesktop.iovar.org/
# Maintainer: Jose V Beneyto, sepen at users dot sourceforge dot net
# Packager: Vincenzo Colosimo, vico at bicisport dot de
# Depends on: recordmydesktop pygtk

name=gtk-recordmydesktop
version=0.3.7.2
release=1
source=(http://dl.sourceforge.net/sourceforge/recordmydesktop/$name-$version.tar.gz)

build() {
  cd $name-$version
  ./configure --prefix=/usr \
              --disable-nls
  make
  make DESTDIR=$PKG install
  rm -r $PKG/usr/share/locale
}
