# Description: politely refuse a login
# URL:         http://www.openbsd.org/cgi-bin/cvsweb/src/sbin/nologin/
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Packager:    Han Boetes <han@mijncomputer.nl>

name=nologin
version=1.0
release=1
source="
    http://www.openbsd.org/cgi-bin/cvsweb/~checkout~/src/sbin/nologin/nologin.c
    http://www.openbsd.org/cgi-bin/cvsweb/~checkout~/src/sbin/nologin/nologin.8
"

build()
{
    gcc -Wall -pedantic $CFLAGS $name.c -o $name
    install -D $name   $PKG/sbin/$name
    install -D $name.8 $PKG/usr/man/man8/$name.8
}
