# Description: a command-line tool for synchronizing calendars and addressbooks
# URL: https://github.com/pimutils/vdirsyncer
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-aiohttp python3-aiostream python3-atomicwrites python3-click-log python3-click-threading python3-requests-toolbelt

name=vdirsyncer
version=0.20.0
release=1
source=(https://pypi.io/packages/source/v/$name/$name-$version.tar.gz)

build() {
  cd $name-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
