# Description: The multidict implementation
# URL: https://github.com/aio-libs/multidict
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-cython

name=python3-multidict
version=6.7.0
release=1
source=(https://github.com/aio-libs/multidict/archive/v$version/$name-$version.tar.gz)

build() {
  cd multidict-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
