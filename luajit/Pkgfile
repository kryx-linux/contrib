# Description: Just-In-Time Compiler for the Lua programming language
# URL: https://luajit.org
# Maintainer: Tim Biermann, tbier at posteo dot de

name=luajit
# https://github.com/LuaJIT/LuaJIT/issues/665#issuecomment-784452583
_commit=97813fb924edf822455f91a5fbbdfdb349e5984f
version=2.1.1727870382
release=1
source=(https://github.com/LuaJIT/LuaJIT/archive/$_commit/$name-$_commit.tar.gz)

build() {
  cd LuaJIT-$_commit

  sed -i 's/%{_libexecdir}/%{_libdir}/' etc/luajit.pc

  make PREFIX="/usr" \
    MULTILIB="/usr/lib" \
    BUILDMODE=dynamic \
    TARGET_STRIP=" @:" \
    amalg
  make PREFIX=/usr DESTDIR=$PKG install

  find $PKG -type f -name *.a -delete -print
}
