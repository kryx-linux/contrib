# Description: Some fancy GNOME programming language
# URL: http://live.gnome.org/Vala
# Maintainer: Brett Goulder, predatorfreak at dcaf-security dot org.
# Packager: Brett Goulder, predatorfreak at dcaf-security dot org.
# Depends on: glib

name=vala
version=0.1.7
release=1
source=(http://download.gnome.org/sources/vala/0.1/$name-$version.tar.bz2)

build() {
	cd $name-$version
	./configure --prefix=/usr \
		--mandir=/usr/man
	make
	make DESTDIR=$PKG install
	rm -rf $PKG/usr/share/devhelp
}
