# Description: Open source emojis
# URL: https://openmoji.org/
# Maintainer: Tim Biermann, tbier at posteo dot de

name=ttf-openmoji
version=16.0.0
release=1
source=(https://github.com/hfg-gmuend/openmoji/archive/$version/openmoji-$version.tar.gz)

build() {
  find openmoji-$version/font/* \
    -iname "*.ttf" \
    -execdir install -Dm644 {} $PKG/usr/share/fonts/TTF/openmoji/{} \;
}
