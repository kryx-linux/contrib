+INSTALL=$(PREFIX)bin/install
 DISTCOMMON=atanks/*.dat atanks/COPYING atanks/README atanks/TODO atanks/Changelog atanks/BUGS atanks/*.txt
-INCOMMON=*.dat COPYING README TODO Changelog *.txt
+INCOMMON=*.dat *.txt
 
 all:
 	FLAGS=-DLINUX $(MAKE) -C src
 
 install: all
