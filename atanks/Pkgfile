# Description: Annihilate the other tanks to earn money, then spend it on bigger and better shields and weapons to wipe out the opposition.
# URL: http://atanks.sourceforge.net/
# Maintainer: Danny Rawlins, crux at romster dot me
# Packager: Danny Rawlins, crux at romster dot me
# Depends on: allegro4

name=atanks
version=6.1
release=1
source=(http://downloads.sourceforge.net/project/$name/$name/$name-$version/$name-$version.tar.gz)

build() {
	cd $name-$version

	sed -i -e 's|share/games/atanks|share/atanks|' Makefile

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/atanks/{COPYING,Changelog,README,TODO}
}
