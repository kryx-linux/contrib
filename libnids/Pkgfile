# Description: implementation of a Network Intrusion Detection System
# URL:         http://libnids.sf.net
# Maintainer:  Thomas Penteker, tek at serverop dot de
# Depends on:  glib, libnet

name=libnids
version=1.23
release=1
source=(http://dl.sourceforge.net/sourceforge/libnids/$name-$version.tar.gz)

build() {
    cd  $name-$version
    ./configure --prefix=/usr
    make
    install -m 644 -D src/libnids.a $PKG/usr/lib/libnids.a
    install -m 644 -D src/nids.h $PKG/usr/include/nids.h
}
