# Description: A graphical monitor for distcc.
# URL: http://distcc.org/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Johannes Winkelmann, jw at tks6 dot net
# Depends on: distcc gtk


name=distcc-monitor
version=3.1
release=1
source=(http://distcc.googlecode.com/files/distcc-$version.tar.bz2)

build() {
	cd distcc-$version

	./configure \
		--prefix=/usr \
		--disable-nls \
		--with-gtk

	make distccmon-gnome
	make distccmon-gnome DESTDIR=$PKG install

	rm -r $PKG/usr/etc $PKG/usr/bin/{lsdistcc,pump}
	rm -r $PKG/usr/{share/doc/,man,bin/distcc{,d,mon-text}}
	rm $PKG/usr/share/distcc/distccmon-gnome.desktop
}
