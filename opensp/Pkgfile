# Description: SGML parser
# URL:         http://openjade.sourceforge.net/
# Packager:    Matt Housh, jaeger at morpheus dot net
# Maintainer:  Han Boetes <han@mijncomputer.nl>
# Depends on:  libstdc++-compat

name=opensp
version=1.5.1
release=1
source="
    http://heanet.dl.sourceforge.net/sourceforge/openjade/OpenSP-$version.tar.gz
    $name-gcc34.patch
"

build()
{
	cd OpenSP-$version
	patch -p1 < $SRC/$name-gcc34.patch
	./configure \
	    --prefix=/usr \
	    --disable-nls \
	    --enable-http \
	    --enable-default-catalog=/etc/sgml/catalog:/etc/xml/catalog \
	    --enable-default-search-path=/usr/share/sgml:/usr/share/xml \
	    --enable-xml-messages
	make
	make install DESTDIR=$PKG
	rm -fr $PKG/usr/{,share/}doc
	for bin in nsgmls sgmlnorm spam spcat spent; do
		ln -s o$bin $PKG/usr/bin/$bin
	done
}
