# Description: Library with common API for various GNOME modules
# URL: https://gitlab.gnome.org/GNOME/gnome-desktop
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: gsettings-desktop-schemas gtk4 iso-codes libseccomp xorg-libxcomposite xorg-libxcursor xorg-libxinerama xkeyboard-config

name=gnome-desktop
version=42.4
release=1
source=(https://download.gnome.org/sources/gnome-desktop/${version::2}/$name-$version.tar.xz)

build() {
  meson setup $name-$version build \
    --prefix=/usr \
    --libexecdir=/usr/lib/$name \
    --buildtype=plain \
    --wrap-mode nodownload \
    --auto-features disabled \
    -D b_lto=true \
    -D b_pie=true \
    -D gnome_distributor="CRUX" \
    -D udev=enabled \
    -D gtk_doc=false \
    -D desktop_docs=false \
    -D systemd=disabled
  meson compile -C build
  DESTDIR=$PKG meson install -C build

  rm -fr $PKG/usr/share/locale
}
