# Description: ACME protocol implementation in Python
# URL: https://pypi.org/project/acme/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-josepy python3-pyrfc3339 python3-requests-toolbelt

name=python3-acme
version=5.6.0
release=1
source=(https://pypi.io/packages/source/a/acme/acme-$version.tar.gz)

build() {
  cd acme-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
