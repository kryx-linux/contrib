# Description: Command line MPD client
# URL: http://www.musicpd.org/mpc.shtml
# Maintainer: Simon Gloﬂner, viper at hometux dot de
# Packager: Mark Rosenstand, mark at borkware dot net

name=mpc
version=0.17
release=1
source=(http://downloads.sourceforge.net/project/musicpd/mpc/0.17/$name-$version.tar.bz2)

build() {
  cd $name-$version

  ./configure \
      --prefix=/usr \
      --mandir=/usr/man
  make
  make DESTDIR=$PKG install

  rm -rf $PKG/usr/share
}
