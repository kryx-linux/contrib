# Description: a script to run docker-compose.yml using podman
# URL: https://github.com/containers/podman-compose
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: podman python3-python-dotenv python3-pyyaml
# Optional: aardvark-dns bash-completion

name=podman-compose
version=1.5.0
release=1
source=(https://github.com/containers/podman-compose/archive/v$version/$name-$version.tar.gz)

build() {
  cd $name-$version

  prt-get isinst bash-completion && install -D -m644 \
    completion/bash/podman-compose \
    $PKG/usr/share/bash-completion/completions/podman-compose

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
