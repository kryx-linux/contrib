# Description: Parse and create Python distribution metadata
# URL: https://github.com/repo-helper/dist-meta
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-domdf-python-tools python3-handy-archives

name=python3-dist-meta
version=0.9.0
release=1
source=(https://pypi.org/packages/source/d/dist_meta/dist_meta-$version.tar.gz)

build() {
  cd dist_meta-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
