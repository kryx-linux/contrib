# Description: A C++ bittorrent library.
# URL: http://www.rasterbar.com/products/libtorrent/
# Maintainer: Danny Rawlins, crux at romster dot me
# Depends on: boost

name=libtorrent-rasterbar1
version=1.1.13
release=1
source=(https://github.com/arvidn/libtorrent/releases/download/libtorrent-${version//./_}/libtorrent-rasterbar-$version.tar.gz)

build() {
	cd libtorrent-rasterbar-$version

	./configure \
		--prefix=/usr \
		--includedir='/usr/include/libtorrent-rasterbar1' \
		--libdir='/usr/lib/libtorrent-rasterbar1'

	make
	make DESTDIR=$PKG install
}
