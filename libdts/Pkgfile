name=libdts
version=0.0.2
release=1
source="ftp://ftp.freebsd.org/pub/FreeBSD/ports/distfiles/libdts-$version.tar.gz"

build()
{
    cd $name-$version
    ./configure \
        --prefix=/usr \
        --disable-nls
    make
    make install DESTDIR=$PKG
}
