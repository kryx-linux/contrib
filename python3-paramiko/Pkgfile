# Description: SSH2 protocol library
# URL: https://pypi.org/project/paramiko/
# Maintainer: Matt Housh, jaeger at crux dot ninja
# Depends on: python3-cryptography python3-bcrypt python3-pynacl

name=python3-paramiko
version=4.0.0
release=1
source=(https://pypi.python.org/packages/source/p/paramiko/paramiko-$version.tar.gz)

build() {
    cd paramiko-$version
    /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
    /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}

